model Strategy {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    // It
    name      String
    data      Json     @default("{}")
    tactics   Json     @default("[]")
    // Relations
    tags      Tag[]
    games     Game[]
    user      User[]
}

model Game {
    // Meta
    id         String       @id @default(cuid())
    createdAt  DateTime     @default(now())
    updatedAt  DateTime     @default(now()) @updatedAt
    // It
    type       GameTypeEnum
    // Relations
    plays      Play[]
    mask       Mask?        @relation(fields: [maskId], references: [id])
    maskId     String?      @unique
    strategy   Strategy?    @relation(fields: [strategyId], references: [id])
    strategyId String?

    @@unique([type, strategyId])
}

model Mask {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    // It
    data      Json
    // Relations
    game      Game?
    // parentId  String?
}

model Unit {
    // Meta
    id           String          @id @default(cuid())
    createdAt    DateTime        @default(now())
    updatedAt    DateTime        @default(now()) @updatedAt
    corpusId     String
    unitType     UnitTypeEnum    @default(WORD)
    // It
    data         Json
    status       UnitStatusEnum?
    // Relations
    tags         Tag[]
    plays        Play[]
    memoryModels MemoryModel[]

    @@unique([corpusId, unitType])
}

model Tag {
    // Meta
    id        String        @id @default(cuid())
    createdAt DateTime      @default(now())
    updatedAt DateTime      @default(now()) @updatedAt
    // It
    name      String        @unique
    type      TagTypeEnum[] @default([])
    data      Json          @default("{}")
    // Relations
    units     Unit[]
    tags      Tag[]         @relation("TagTag")
    fromTag   Tag[]         @relation("TagTag")
    strategy  Strategy[]
}

model MemoryModel {
    // Meta
    id        String           @id @default(cuid())
    createdAt DateTime         @default(now())
    updatedAt DateTime         @default(now()) @updatedAt
    // It
    type      MemoryTypeEnum   @default(EBISU_v2)
    status    MemoryStatusEnum @default(UNKNOWN)
    state     Json             @default("{}")
    lastSeen  DateTime?
    history   Json             @default("[]")
    // Relations
    unit      Unit             @relation(fields: [unitId], references: [id])
    unitId    String
    user      User             @relation(fields: [userId], references: [id])
    userId    String           @default("clph9fwsl0000g0qt5l1wgvg1")
    plays     Play[]

    @@unique([unitId, userId])
}

model Play {
    // Meta
    id        String      @id @default(cuid())
    createdAt DateTime    @default(now())
    updatedAt DateTime    @default(now()) @updatedAt
    history   Json        @default("[]")
    // It
    nextPlay  DateTime
    lastPlay  DateTime
    // Relations
    unit      Unit        @relation(fields: [unitId], references: [id])
    unitId    String
    game      Game        @relation(fields: [gameId], references: [id])
    gameId    String
    user      User        @relation(fields: [userId], references: [id])
    userId    String      
    memory    MemoryModel @relation(fields: [memoryId], references: [id])
    memoryId  String

    @@unique([unitId, gameId, userId, memoryId])
}

enum TagTypeEnum {
    STRUCTURAL // organizing and completable 
    ONTOLOGICAL // subject matter attribute
    LEARNABLE // higher order feature
}

enum MemoryTypeEnum {
    EBISU_v2
    EBISU_v3
}

enum GameTypeEnum {
    FLASHCARDS
    TRANSLATIONS
}

enum UnitTypeEnum {
    WORD
    CONJUGATION
}

enum MemoryStatusEnum {
    UNKNOWN // not yet being learned
    LEARNING // being learned 
    KNOWN // sufficiently learned
    GRADUATED // sufficiently learned and not Showing anymore
}

enum UnitStatusEnum {
    HIDDEN // dont show
    PRIORITIZED // start learning asp
}

