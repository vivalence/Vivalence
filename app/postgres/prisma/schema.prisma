generator local-client {
  // output       = "../../app/backend/node_modules/.prisma/client"
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
  clientOutput    = "@prisma/client"
}

generator backend-client {
  provider        = "prisma-client-js"
  output          = "../../app/backend/node_modules/.prisma/client"
  previewFeatures = ["views"]
  clientOutput    = "@prisma/client"
}

generator pothos-client {
  provider        = "prisma-pothos-types"
  output          = "../../app/backend/node_modules/@pothos/test"
  previewFeatures = ["views"]
  clientOutput    = "../../app/backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  // Meta
  id         String          @id @unique // same as auth."users".id
  authUser   AuthUser        @relation(fields: [id], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now()) @updatedAt
  email      String?        
  // It
  roles      UserRolesEnum[] @default([USER]) // synced to raw_user_meta_data by pg hook
  strategies Strategy[]      @relation("AppUserToStrategy")
}

model Strategy {
  // Meta
  id        String    @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  // It
  name      String
  data      Json      @default("{}")
  tactics   Json      @default("[]")
  // Relations
  user      AppUser[] @relation("AppUserToStrategy")
  //     // It
  //     name      String
  //     data      Json     @default("{}")
  //     tactics   Json     @default("[]")
  //     // Relations
  //     // tags      Tag[]
  //     // games     Game[]
}

