generator app-client {
  output          = "../../frontend/node_modules/.prisma/client"
  provider        = "prisma-client-js"
  clientOutput    = "@prisma/client"
  previewFeatures = ["views"]
}

generator local-client {
  provider        = "prisma-client-js"
  clientOutput    = "@prisma/client"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  // extensions = [pg_graphql, pg_net, pg_stat_statements, pgcrypto, pgjwt, pgsodium, supabase_vault]
  url      = env("DATABASE_URL")
}

model AppUser {
  id          String          @id @unique // same as auth."users".id
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  email       String?
  roles       UserRolesEnum[] @default([USER]) // synced to raw_user_meta_data by pg hook
  strategies  Strategy[]      @relation("AppUserToStrategy")
  Play        Play[]
  MemoryModel MemoryModel[]
}

model Strategy {
  id        String    @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  name      String
  data      Json      @default("{}")
  user      AppUser[] @relation("AppUserToStrategy")
  tags      Tag[]     @relation("StrategyToTag")
  games     Game[]    @relation("StrategyToGame")
}

model Game {
  id         String       @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt
  name       String
  type       GameTypeEnum
  data       Json         @default("{}")
  plays      Play[]
  strategies Strategy[]   @relation("StrategyToGame")

  // @@unique([type, ])
}

model Play {
  id        String      @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  history   Json        @default("[]")
  nextPlay  DateTime
  lastPlay  DateTime
  unit      Unit        @relation(fields: [unitId], references: [id])
  unitId    String
  game      Game        @relation(fields: [gameId], references: [id])
  gameId    String
  user      AppUser     @relation(fields: [userId], references: [id])
  userId    String
  memory    MemoryModel @relation(fields: [memoryId], references: [id])
  memoryId  String

  @@index([unitId], name: "unitIdIndexOnPlay")
  @@index([userId], name: "userIdIndexOnPlay")
  @@index([gameId], name: "gameIdIndexOnPlay")
  @@index([memoryId], name: "memoryIdIndexOnPlay")
  @@unique([unitId, gameId, userId, memoryId])
}

model MemoryModel {
  id        String           @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  type      MemoryTypeEnum   @default(EBISU_v2)
  status    MemoryStatusEnum @default(UNKNOWN)
  state     Json             @default("{}")
  lastSeen  DateTime?
  history   Json             @default("[]")
  unit      Unit             @relation(fields: [unitId], references: [id])
  unitId    String
  user      AppUser          @relation(fields: [userId], references: [id])
  userId    String
  plays     Play[]

  @@index([unitId], name: "unitIdIndexOnMemoryModel")
  @@index([userId], name: "userIdIndexOnMemoryModel")
  @@unique([unitId, userId])
}

model Tag {
  id        String        @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  name      String        @unique
  type      TagTypeEnum[] @default([])
  data      Json          @default("{}")
  units     Unit[]
  strategy  Strategy[]    @relation("StrategyToTag")

  @@index([name], name: "nameIndexOnTag")
}

model Unit {
  id           String         @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  corpusId     String
  corpusType   CorpusTypeEnum @default(WORD)
  data         Json
  tags         Tag[]
  plays        Play[]
  memoryModels MemoryModel[]

  @@index([corpusId], name: "corpusIdIndexOnUnit")
  @@unique([corpusId, corpusType])
}

enum QueueStatusEnum {
  PENDING

  PROCESSING
  DONE
  FAILED
}

model Queue {
  id          String         @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt @default(now())
  userId      String
  strategyId  String
  status      QueueStatusEnum @default(PENDING)
  data        Json           @default("{}")
}


enum CorpusTypeEnum {
  WORD
  CONJUGATION
}

enum TagTypeEnum {
  STRUCTURAL // organizing and completable 
  ONTOLOGICAL // subject matter attribute
  LEARNABLE // higher order feature
}

enum MemoryTypeEnum {
  EBISU_v2
  EBISU_v3
}

enum GameTypeEnum {
  FLASHCARDS
  TRANSLATIONS
}

enum MemoryStatusEnum {
  UNKNOWN // not yet being learned
  LEARNING // being learned 
  KNOWN // sufficiently learned
  GRADUATED // sufficiently learned and not Showing anymore
}

enum UnitStatusEnum {
  HIDDEN // dont show
  PRIORITIZED // start learning asp
}

enum UserRolesEnum {
  ADMIN
  USER
  GUEST
}
