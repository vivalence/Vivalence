// Lessons
// Games
// Curricula
// Narratives

model Course {
    // Meta
    id           String                  @id @default(cuid())
    createdAt    DateTime                @default(now())
    updatedAt    DateTime                @default(now()) @updatedAt
    // It
    name         String
    // Relations
    curriculum   Curriculum              @relation(fields: [curriculumId], references: [id])
    curriculumId String
    // Down
    lessons      CourseLessonsRelation[]
}

model Lesson {
    id          String     @id @default(cuid())
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @default(now()) @updatedAt
    // It
    title       String
    description String?
    // Relations
    narrative   Narrative? @relation(fields: [narrativeId], references: [id])
    narrativeId String?

    curriculumRelation CurriculumLessonRelation? @relation(fields: [curriculumId], references: [id])
    curriculumId       String?

    userLessonRelations UserLessonRelation[]
}

model CourseLessonsRelation {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    // It
    index     Int
    // Relations
    course    Course   @relation(fields: [courseId], references: [id])
    courseId  String
    lesson    Lesson   @relation(fields: [lessonId], references: [id])
    lessonId  String

    @@unique([lessonId, courseId])
}

model CurriculumLessonRelation {
    // Meta
    id           String     @id @default(cuid())
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @default(now()) @updatedAt
    // It
    index        Int
    // Relations
    curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
    curriculumId String
    lesson       Lesson     @relation(fields: [lessonId], references: [id])
    lessonId     String

    @@unique([lessonId, curriculumId])
}

model UserLessonRelation {
    // Meta
    id        String               @id @default(cuid())
    createdAt DateTime             @default(now())
    updatedAt DateTime             @default(now()) @updatedAt
    // It
    status    UserLessonStatusEnum @default(UNKNOWN)
    // Relations
    lesson    Lesson               @relation(fields: [lessonId], references: [id])
    lessonId  String
    user      User                 @relation(fields: [userId], references: [id])
    userId    String

    @@unique([lessonId, userId])
}

enum UserLessonStatusEnum {
    VIEWED
    UNVIEWED
}

model Narrative {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    content   String // markdown
    Lesson    Lesson   @relation(fields: [lessonId], references: [id])
    lessonId  String
}

model Standard {
    id          Int    @id @default(autoincrement())
    title       String
    description String
}

