model Word {
    // Meta
    id             String             @id @default(cuid())
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @default(now()) @updatedAt
    // It
    index          Int                @unique
    spanish        String
    english        String
    type           WordTypeEnum
    pos            PartOfSpeechEnum[] @default([])
    lemmaSpanish   String?
    lemmaEnglish   String?
    ud             Json?
    usageInSpanish String?
    usageInEnglish String?
    data           Json?
    // Up
    // Down
    conjugations   Conjugation[]
    // no more status, review and review id, thats on the gameunitrelation now.
}

model Conjugation {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    // It
    spanish      String
    english      String?
    lemmaSpanish String?
    lemmaEnglish String?

    tense     TenseEnum?
    performer PerformerEnum?
    mood      MoodEnum?
    form      VerbFormEnum?
    ending    EndingEnum?
    ud        Json?

    // Up
    verb   Word   @relation(fields: [verbId], references: [id])
    verbId String

    // Down
    // verbStem   VerbStem?
    // verbEnding VerbEnding?

    @@unique([verbId, tense, performer, mood])
}

// model VerbStem {// Meta id            String       @id @default(cuid()) createdAt     DateTime     @default(now()) updatedAt     DateTime     @default(now()) @updatedAt // It value         String tense         TenseEnum mood          MoodEnum // Up conjugation   Conjugation? @relation(fields: [conjugationId], references: [id]) conjugationId String?      @unique}

// model VerbEnding {// Meta id            String        @id @default(cuid()) createdAt     DateTime      @default(now()) updatedAt     DateTime      @default(now()) @updatedAt // It value         String ending        EndingEnum tense         TenseEnum performer     PerformerEnum mood          MoodEnum // Up conjugation   Conjugation?  @relation(fields: [conjugationId], references: [id]) conjugationId String?       @unique}

enum MoodEnum {
    INDICATIVO
    SUBJUNTIVO

    IMPERATIVO
    IMPERATIVO_AFIRMATIVO
    IMPERATIVO_NEGATIVO

    NON_FINITE

    Indicative
    Subjunctive
    Imperative
    Conditional

    Participle
    Infinitive
    Gerund
    Conditional
}

enum PolarityEnum {
    Positive
    Negative
}

enum VerbFormEnum {
    // "Infinitive", "Participle", "Finite", "Gerund"
    Infinitive
    Participle
    Finite
    Gerund
}

