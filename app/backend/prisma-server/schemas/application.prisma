model User {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    // It
    // Down
}

model Unit {
    // Meta
    id                  String                   @id @default(cuid())
    createdAt           DateTime                 @default(now())
    updatedAt           DateTime                 @default(now()) @updatedAt
    corpusId            String
    unitType            UnitTypeEnum             @default(WORD)
    // It
    data                Json
    status              UnitStatusEnum?
    tags                Tag[]
    // Up
    curriculumRelations CurriculumUnitRelation[]
    gameRelations       GameUnitRelation[]
    memoryModels        MemoryModel[]

    @@unique([corpusId, unitType]) // + userId 
}

model Tag {
    // Meta
    id            String        @id @default(cuid())
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @default(now()) @updatedAt
    // It
    name          String        @unique
    type          TagTypeEnum[] @default([])
    unitRelations Unit[]
}

model Curriculum {
    // Meta
    id            String                   @id @default(cuid())
    createdAt     DateTime                 @default(now())
    updatedAt     DateTime                 @default(now()) @updatedAt
    // It
    name          String
    // Down
    gameRelations CurriculumGameRelation[]
    unitRelations CurriculumUnitRelation[]
}

model Game {
    // Meta
    id                 String                  @id @default(cuid())
    createdAt          DateTime                @default(now())
    updatedAt          DateTime                @default(now()) @updatedAt
    // It
    type               GameTypeEnum
    // Relations
    curriculumRelation CurriculumGameRelation?
    unitRelations      GameUnitRelation[]
}

model Mask {
    // Meta
    id                     String                   @id @default(cuid())
    createdAt              DateTime                 @default(now())
    updatedAt              DateTime                 @default(now()) @updatedAt
    // It
    data                   Json
    // relations
    CurriculumGameRelation CurriculumGameRelation[]
}

model MemoryModel {
    // Meta
    id        String           @id @default(cuid())
    createdAt DateTime         @default(now())
    updatedAt DateTime         @default(now()) @updatedAt
    // It
    type      MemoryTypeEnum   @default(EBISU_v2)
    status    MemoryStatusEnum @default(UNKNOWN)
    state     Json             @default("{}")
    lastSeen  DateTime?
    history   Json             @default("[]")
    // Relations
    unit      Unit             @relation(fields: [unitId], references: [id])
    unitId    String
    // user      User             @relation(fields: [userId], references: [id])
    // userId    String

    @@unique([unitId])
}

model CurriculumUnitRelation {
    // Meta
    id           String     @id @default(cuid())
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @default(now()) @updatedAt
    // It
    index        Int
    // Relations
    curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
    curriculumId String
    unit         Unit       @relation(fields: [unitId], references: [id])
    unitId       String

    @@unique([unitId, curriculumId])
}

model GameUnitRelation {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    history   Json     @default("[]")
    // It
    nextPlay  DateTime
    lastPlay  DateTime
    // state     Json     @default("{}")
    // Relations
    unit      Unit     @relation(fields: [unitId], references: [id])
    unitId    String
    game      Game     @relation(fields: [gameId], references: [id])
    gameId    String

    @@unique([unitId, gameId])
}

model CurriculumGameRelation {
    // Meta
    id           String     @id @default(cuid())
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @default(now()) @updatedAt
    // Relations
    curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
    curriculumId String
    game         Game       @relation(fields: [gameId], references: [id])
    gameId       String     @unique
    // It
    mask         Mask       @relation(fields: [maskId], references: [id])
    maskId       String

    @@unique([gameId, curriculumId])
}

enum TagTypeEnum {
    STRUCTURAL
    LEARNABLE
    SET
}

enum MemoryTypeEnum {
    EBISU_v2
    EBISU_v3
}

enum GameTypeEnum {
    FLASHCARDS
    TRANSLATIONS
}

enum UnitTypeEnum {
    WORD
    CONJUGATION
}

enum MemoryStatusEnum {
    UNKNOWN // not yet being learned
    LEARNING // being learned 
    KNOWN // sufficiently learned
    GRADUATED // sufficiently learned and not Showing anymore
}

enum UnitStatusEnum {
    HIDDEN // dont show
    PRIORITIZED // start learning asp
}

