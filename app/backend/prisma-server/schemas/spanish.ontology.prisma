model Word {
    // Meta
    id             String        @id @default(cuid())
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @default(now()) @updatedAt
    // It
    index          Int           @unique
    spanish        String
    english        String
    type           WordTypeEnum
    usageInSpanish String?
    usageInEnglish String?
    data           Json?
    // Up
    // Down
    conjugations   Conjugation[]
    // no more status, review and review id, thats on the gameunitrelation now.
}

model Conjugation {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    // It
    spanish   String
    english   String?
    tense     TenseEnum     @default(NON_TEMPORAL)
    performer PerformerEnum @default(NON_FINITE)
    mood      MoodEnum      @default(NON_FINITE)
    ending    EndingEnum?

    // Up
    verb   Word   @relation(fields: [verbId], references: [id])
    verbId String

    // Down
    // verbStem   VerbStem?
    // verbEnding VerbEnding?

    @@unique([verbId, tense, performer, mood])
}

