generator client {
    provider = "prisma-client-js"
}

generator pothos {
    provider     = "prisma-pothos-types"
    clientOutput = "@prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

//
// App
// 

model User {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    // It
    // name     String
    // Down
    // curriculums Curriculum[]
}

model Unit {
    // Meta
    id                  String                   @id @default(cuid())
    createdAt           DateTime                 @default(now())
    updatedAt           DateTime                 @default(now()) @updatedAt
    // It
    data                Json
    corpusId            String
    unitType            UnitTypeEnum             @default(WORD)
    status              UnitStatusEnum           @default(UNKNOWN)
    // Up
    curriculumRelations CurriculumUnitRelation[]
    gameRelations       GameUnitRelation[]

    @@unique([corpusId, unitType]) // + userId 
}

model Curriculum {
    // Meta
    id            String                   @id @default(cuid())
    createdAt     DateTime                 @default(now())
    updatedAt     DateTime                 @default(now()) @updatedAt
    // It
    name          String
    // Down
    gameRelations CurriculumGameRelation[]
    unitRelations CurriculumUnitRelation[]
}

model Game {
    // Meta
    id                 String                  @id @default(cuid())
    createdAt          DateTime                @default(now())
    updatedAt          DateTime                @default(now()) @updatedAt
    // It
    type               GameTypeEnum
    // Relations
    curriculumRelation CurriculumGameRelation?
    unitRelations      GameUnitRelation[]
}

model CurriculumUnitRelation {
    // Meta
    id           String     @id @default(cuid())
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @default(now()) @updatedAt
    // It
    index        Int
    // Relations
    curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
    curriculumId String
    unit         Unit       @relation(fields: [unitId], references: [id])
    unitId       String

    @@unique([unitId, curriculumId])
}

model GameUnitRelation {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    history   Json     @default([])
    // It
    nextPlay  DateTime
    lastPlay  DateTime
    state     Json
    // Relations
    unit      Unit     @relation(fields: [unitId], references: [id])
    unitId    String
    game      Game     @relation(fields: [gameId], references: [id])
    gameId    String

    @@unique([unitId, gameId])
}

model CurriculumGameRelation {
    // Meta
    id           String     @id @default(cuid())
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @default(now()) @updatedAt
    // Relations
    curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
    curriculumId String
    game         Game       @relation(fields: [gameId], references: [id])
    gameId       String     @unique
    // It
    mask         Mask       @relation(fields: [maskId], references: [id])
    maskId       String

    @@unique([gameId, curriculumId])
}

enum GameTypeEnum {
    FLASHCARDS
}

enum UnitTypeEnum {
    WORD
    VERB_CONJUGATION
    VERB_STEM
    VERB_ENDING
}

enum UnitStatusEnum {
    HIDDEN // not yet known but dont show
    PRIORITIZED // start learning asp
    UNKNOWN // not yet being learned
    LEARNING // being learned 
    KNOWN // sufficiently learned
    GRADUATED // sufficiently learned and not Showing anymore
}

model Mask {
    // Meta
    id                     String                   @id @default(cuid())
    createdAt              DateTime                 @default(now())
    updatedAt              DateTime                 @default(now()) @updatedAt
    // It
    data                   Json
    // relations
    CurriculumGameRelation CurriculumGameRelation[]
}

//
// CORPUS
// 

model Word {
    // Meta
    id             String        @id @default(cuid())
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @default(now()) @updatedAt
    // It
    index          Int           @unique
    spanish        String
    english        String
    type           WordTypeEnum
    usageInSpanish String?
    usageInEnglish String?
    data           Json?
    // Up
    // Down
    conjugations   Conjugation[]
    // no more status, review and review id, thats on the gameunitrelation now.
}

model Conjugation {
    // Meta
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    // It
    value     String
    tense     TenseEnum
    performer PerformerEnum
    ending    EndingEnum
    mood      MoodEnum

    // Up
    verb   Word   @relation(fields: [verbId], references: [id])
    verbId String

    // Down
    verbStem   VerbStem?
    verbEnding VerbEnding?

    @@unique([verbId, tense, performer, mood])
}

model VerbStem {
    // Meta
    id            String       @id @default(cuid())
    createdAt     DateTime     @default(now())
    updatedAt     DateTime     @default(now()) @updatedAt
    // It
    value         String
    tense         TenseEnum
    mood          MoodEnum
    // Up
    conjugation   Conjugation? @relation(fields: [conjugationId], references: [id])
    conjugationId String?      @unique
}

model VerbEnding {
    // Meta
    id            String        @id @default(cuid())
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @default(now()) @updatedAt
    // It
    value         String
    ending        EndingEnum
    tense         TenseEnum
    performer     PerformerEnum
    mood          MoodEnum
    // Up
    conjugation   Conjugation?  @relation(fields: [conjugationId], references: [id])
    conjugationId String?       @unique
}

enum MoodEnum {
    INDICATIVO
    SUBJUNTIVO
    IMPERATIVO_AFIRMATIVO
    IMPERATIVO_NEGATIVO
    NON_FINITE
}

enum TenseEnum {
    INFINITIVO
    GERUNDIO
    PARTICIPIO

    PRESENTE
    PRETERITO
    IMPERFECTO
    FUTURO
    CONDICIONAL

    FUTURO_PERFECTO
    PLUSCUAMPERFECTO
    PRESENTE_PERFECTO
    PRETERITO_ANTERIOR
    CONDICIONAL_PERFECTO
}

enum PerformerEnum {
    NON_FINITE
    YO
    TU
    EL_ELLA_USTED
    NOSOTROS_NOSOTRAS
    VOSOTROS_VOSOTRAS
    ELLOS_ELLAS_USTEDES
}

enum EndingEnum {
    ER
    AR
    IR
}

enum WordTypeEnum {
    ART
    ADJ
    ADV
    CONJ
    F
    PLUS_FAM
    MINUS_FAM
    INTERJ
    M
    N
    NC
    NF
    NF_EL
    NM
    NMF
    NM_F
    NUM
    OBJ
    DIR_OBJ
    INDIR_OBJ
    PL
    PREP
    PRON
    SG
    SUBI
    V // infitiivo
    // V_G
    // V_P
    SPEAKERS
}
