  font-weight: 200;
  font-style: normal;
}
@font-face {
  font-family: 'Kabel';
  src: url('../static/fonts/Kabel/NeueKabel-ThinItalic.otf') format('opentype');
  font-weight: 200;
  font-style: italic;
}

@font-face {
  font-family: 'Kabel';
  src: url('../static/fonts/Kabel/NeueKabel-Light.otf') format('opentype');
  font-weight: 300;
  font-style: normal;
}
