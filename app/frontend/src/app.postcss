/* Source Code Pro font */
@font-face {
  font-family: 'Source Code Pro';
  src: url('../static/fonts/Source Code Pro/SourceCodePro-VariableFont_wght.ttf') format('truetype');
  font-weight: 100 900;
  font-style: normal;
}
@font-face {
  font-family: 'Source Code Pro';
  src: url('../static/fonts/Source Code Pro/SourceCodePro-Italic-VariableFont_wght.ttf') format('truetype');
  font-weight: 100 900;
  font-style: italic;
}


