  font-style: italic;
}

@font-face {
  font-family: 'Kabel';
  src: url('../static/fonts/Kabel/NeueKabel.otf') format('opentype');
  font-weight: 400;
  font-style: normal;
}
@font-face {
  font-family: 'Kabel';
  src: url('../static/fonts/Kabel/NeueKabel-Italic.otf') format('opentype');
  font-weight: 400;
  font-style: italic;
}

@font-face {
  font-family: 'Kabel';
  src: url('../static/fonts/Kabel/NeueKabel-Medium.otf') format('opentype');
  font-weight: 500;
  font-style: normal;
}
@font-face {
