/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Thin or Hairline: 100 */
/* Extra Light or Ultra Light: 200 */
/* Light: 300 */
/* Regular or Normal: 400 */
/* Medium: 500 */
/* Semi Bold or Demi Bold: 600 */
/* Bold: 700 */
/* Extra Bold or Ultra Bold: 800 */
/* Black or Heavy: 900 */

/* Sabon font */
@font-face {
  font-family: 'Sabon';
  src: url('/fonts/Sabon/Sabon.ttf') format('truetype');
  font-weight: 400;
  font-style: normal;
}

@font-face {
  font-family: 'Sabon';
  src: url('/fonts/Sabon/SabonItalic.ttf') format('truetype');
  font-weight: 400;
  font-style: italic;
}
@font-face {
  font-family: 'Sabon';
  src: url('/fonts/Sabon/SabonBold.ttf') format('truetype');
  font-weight: 700;
  font-style: normal;
}

@font-face {
  font-family: 'Sabon';
  src: url('/fonts/Sabon/SabonBoldItalic.ttf') format('truetype');
  font-weight: 700;
  font-style: italic;
}

/* Add other variants for Sabon if they exist (e.g., Italic) */

/* K2D font */
@font-face {
  font-family: 'K2D';
  src: url('/fonts/K2D/K2D-Light.ttf') format('truetype');
  font-weight: 300;
  font-style: normal;
}

@font-face {
  font-family: 'K2D';
  src: url('/fonts/K2D/K2D-Regular.ttf') format('truetype');
  font-weight: 500;
  font-style: normal;
}

@font-face {
  font-family: 'K2D';
  src: url('/fonts/K2D/K2D-SemiBold.ttf') format('truetype');
  font-weight: 600;
  font-style: normal;
}

@font-face {
  font-family: 'K2D';
  src: url('/fonts/K2D/K2D-Bold.ttf') format('truetype');
  font-weight: 700;
  font-style: normal;
}

/* Add other variants for Avant Garde if they exist (e.g., Italic) */

/* Kabel font */
@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel-Thin.otf') format('opentype');
  font-weight: 200;
  font-style: normal;
}
@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel-ThinItalic.otf') format('opentype');
  font-weight: 200;
  font-style: italic;
}

@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel-Light.otf') format('opentype');
  font-weight: 300;
  font-style: normal;
}
@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel-LightItalic.otf') format('opentype');
  font-weight: 300;
  font-style: italic;
}

@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel.otf') format('opentype');
  font-weight: 400;
  font-style: normal;
}
@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel-Italic.otf') format('opentype');
  font-weight: 400;
  font-style: italic;
}

@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel-Medium.otf') format('opentype');
  font-weight: 500;
  font-style: normal;
}
@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel-MediumItalic.otf') format('opentype');
  font-weight: 500;
  font-style: italic;
}

@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel-Bold.otf') format('opentype');
  font-weight: 700;
  font-style: normal;
}
@font-face {
  font-family: 'Kabel';
  src: url('/fonts/Kabel/NeueKabel-BoldItalic.otf') format('opentype');
  font-weight: 700;
  font-style: italic;
}

/* Add variants for Kabel if they exist (e.g., Bold, Italic) */

/* Source Code Pro font */
@font-face {
  font-family: 'Source Code Pro';
  src: url('/fonts/Source Code Pro/SourceCodePro-VariableFont_wght.ttf') format('truetype');
  font-weight: 100 900;
  font-style: normal;
}
@font-face {
  font-family: 'Source Code Pro';
  src: url('/fonts/Source Code Pro/SourceCodePro-Italic-VariableFont_wght.ttf') format('truetype');
  font-weight: 100 900;
  font-style: italic;
}


/* Add other variants for Source Code Pro if they exist (e.g., Italic) */
html, body {
    @apply h-full overflow-hidden;
}

:root [data-theme='rocket'] {
    --theme-font-family-base: 'Kabel', sans-serif;
    --theme-font-family-heading: 'Sabon', serif;
    --theme-font-family-brand: 'K2D', sans-serif;
    /* ... */
}

.v-card h1 {
    @apply h1;
}
.v-card h2 {
    @apply h2;
}
.v-card h3 {
    @apply h3;
}
.v-card h4 {
    @apply h4;
}
.v-card h5 {
    @apply h5;
}
.v-card h6 {
    @apply h6;
}


input[type='text'] {
}