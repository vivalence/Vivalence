{
  "instances": "./instances.json",
  "registry": "./registry.json",
  "environment": "./environment.json",
  "runtime": {
    "statics": { "serve": "${VIVA_RUNTIME_SERVE}", "remote": "${PUBLIC_VIVA_RUNTIME_REMOTE}" },
    "modes": ["@commons/harness/runtime"]
  },
  "lighthouse": { "secrets": { "jwt": "${SECRET_VIVA_JWT}" }, "traits": ["AUTOSIGNUP"] },
  "datamap": { "module": "@commons/datamap/libsql" },
  "hallucinators": [
    {
      "module": "@commons/hallucinator/openrouter",
      "secrets": { "key": "${SECRET_VIVA_OPENROUTER_API_KEY}" },
      "faculties": [
        { "type": "dialogue", "id": "google/gemini-3.8-flash", "tune": [0.45, 0.85, 0.7], "context": 1048576, "thinking": true }
      ]
    }
  ],
  "clients": [
    { "manifest": { "type": "client", "slug": "anima" }, "statics": { "serve": "${VIVA_CLIENT_ANIMA_SERVE}" } },
    { "manifest": { "type": "client", "slug": "ghost" }, "modes": ["@commons/home/console"] }
  ]
}
