+</nav>
+<a class="contents" href="${home(article.page)}">↑</a>
+</article>`,
+  });
+
+export const page = ({ site, nav, article }) =>
+  framed({
+    site,
+    nav,
+    page: article.page,
+    title: article.title,
+    description: article.subtitle,
+    image: article.image,
+    type: "website",
+    body: `<article class="prose">
+${article.body}
+</article>`,
+  });
+
+const tags = (article) =>
+  article.tags === undefined
