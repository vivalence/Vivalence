#+BEGIN_SRC javascript :tangle ../../subsystems/paladin/tests/vip.test.js :mkdirp yes
import { describe, it } from "@std/testing/bdd";
import { expect } from "@std/expect";
import { Vip } from "../prototypes/vip.js";

const rootStub = (dir) => ({
  absolute: dir,
  branch: (child) => ({ absolute: `${dir}/${child}` }),
});

// declaration: what package.viva.js resolves to (null = file absent, pure derivation).
// moduleManifests: manifest for each walked module, keyed by path (omit "package" to inherit).
const fakePaladin = (declaration, modulePaths, moduleManifests = {}) => ({
  read: {
    viva: async (path) => {
      const absolute = path.absolute ?? String(path);
      if (absolute.endsWith("package.viva.js")) {
        if (!declaration) throw new Error("no package.viva.js");
        return { manifest: declaration };
      }
      const slug = absolute.split("/").at(-2);
      return { manifest: { type: "game", slug, version: "0.0.1", ...moduleManifests[absolute] } };
    },
  },
  find: {
    viva: async () => modulePaths.map((absolute) => ({ absolute })),
  },
});

describe("Vip.mount", () => {
  it("derives the package from the mount path by default — no package.viva.js needed", async () => {
    const paladin = fakePaladin(null, ["/registry/simulation/game/write/write.viva.js"]);
    const vip = new Vip(paladin);
    await vip.mount(rootStub("/registry/simulation"));

    const module = await vip.pensieve.revelio({ package: "@simulation", type: "game", slug: "write" });
    expect(module).toBeTruthy();
    expect(module.manifest.package).toBe("@simulation");
  });

  it("a package.viva.js self-declaration LOCKS the derived name", async () => {
    const paladin = fakePaladin(
      { type: "package", slug: "fixture", version: "0.0.1", package: "@vivalence" },
      ["/registry/simulation/game/write/write.viva.js"],
    );
    const vip = new Vip(paladin);
    await vip.mount(rootStub("/registry/simulation"));

    const module = await vip.pensieve.revelio({ package: "@vivalence", type: "game", slug: "write" });
    expect(module.manifest.package).toBe("@vivalence");
  });

  it("a module's own manifest.package LOCKS it, overriding the package-derived stamp", async () => {
    const modulePath = "/registry/simulation/fixture/lock-demo/lock-demo.viva.js";
    const paladin = fakePaladin(null, [modulePath], { [modulePath]: { package: "@vivalence", type: "fixture", slug: "lock-demo" } });
    const vip = new Vip(paladin);
    await vip.mount(rootStub("/registry/simulation"));

    const locked = await vip.pensieve.revelio({ package: "@vivalence", type: "fixture", slug: "lock-demo" });
    expect(locked).toBeTruthy();
    const notUnderSimulation = await vip.pensieve.revelio({ package: "@simulation", type: "fixture", slug: "lock-demo" });
    expect(notUnderSimulation).toBeNull();
  });
});
