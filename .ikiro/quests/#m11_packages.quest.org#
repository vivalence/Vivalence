import * as semver from "@std/semver";
import { Manifest } from "./manifest.js";

export class Pensieve extends Map {
  register(cake) {
    if (!cake || !cake.manifest) console.log("no manifest", cake);
    cake.manifest = new Manifest(cake.manifest);
    const { manifest } = cake;
    // package is supplied by vip.mount (derived from scope, or locked) — never defaulted here.
    if (!manifest.package)
      throw new Error(`[Pensieve] register: no package (mount must stamp) — ${manifest.type}/${manifest.slug}`);

    if (!this.has(manifest.package)) this.set(manifest.package, new Map());
    const packageMap = this.get(manifest.package);

    if (!packageMap.has(manifest.type)) packageMap.set(manifest.type, new Map());
    const typeMap = packageMap.get(manifest.type);

    if (!typeMap.has(manifest.slug)) typeMap.set(manifest.slug, new Map());
    const slugMap = typeMap.get(manifest.slug);

    slugMap.set(manifest.version, cake);
    return this;
  }

  async revelio(lookup) {
    const slugMap = this.get(lookup.package)?.get(lookup.type)?.get(lookup.slug);
    if (!slugMap) return null;
    if (!lookup.version) return this.latest(slugMap);

    const versions = Array.from(slugMap.keys());
    const matchingVersion = versions.find((version) => semver.satisfies(version, lookup.version));
    return matchingVersion ? slugMap.get(matchingVersion) : null;
  }

  latest(slugMap) {
    const [top] = Array.from(slugMap.keys())
      .sort((a, b) => semver.compare(semver.parse(a), semver.parse(b)))
      .reverse();
    return slugMap.get(top);
  }

  byType(type) {
    const out = [];
    for (const packageMap of this.values())
      for (const slugMap of packageMap.get(type)?.values() ?? []) out.push(this.latest(slugMap));
    return out;
  }
}
#+END_SRC

