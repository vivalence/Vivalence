@@ -0,0 +1,162 @@
+import { specimen, verbatim } from "@vivalence/typology";
+
+async function* script(events) {
+  yield* events;
+}
+
+async function collect(stream) {
+  const out = [];
+  for await (const event of stream) out.push(event);
+  return out;
+}
+
+const partial = (transcript) => ({ nature: "partial", transcript });
+const commits = (events) => events.filter((e) => e.nature === "commit").map((e) => e.text);
+const partials = (events) => events.filter((e) => e.nature === "partial").map((e) => e.transcript);
+
+specimen.describe("belt.verbatim.harmonize — LocalAgreement with tolerance", () => {
+  specimen.it("commits the agreed prefix across the window, tail shrinks", async () => {
+    const events = await collect(
+      verbatim.harmonize(
+        script([partial("the"), partial("the quick"), partial("the quick brown")]),
+        { window: 2 },
+      ),
+    );
+    specimen.expect(commits(events)).toEqual(["the", "quick"]);
+    specimen.expect(partials(events)).toEqual(["the", "quick", "brown"]);
+  });
+
+  specimen.it("never commits a flickering word", async () => {
+    const events = await collect(
+      verbatim.harmonize(
+        script([partial("the quick brawn"), partial("the quick brown fox")]),
+        { window: 2, tolerance: 1 },
+      ),
+    );
+    specimen.expect(commits(events)).toEqual(["the quick"]);
+  });
+
+  specimen.it("tolerates near-identical spellings", async () => {
+    const events = await collect(
+      verbatim.harmonize(
+        script([partial("vivalance rocks"), partial("vivalence rocks hard")]),
+        { window: 2, tolerance: 0.8 },
+      ),
+    );
+    specimen.expect(commits(events)[0]).toBe("vivalence rocks");
+  });
+
+  specimen.it("final flushes the remainder as one commit and passes through", async () => {
+    const events = await collect(
+      verbatim.harmonize(
+        script([
+          partial("count to"),
+          partial("count to three"),
+          { nature: "final", transcript: "count to three now" },
+        ]),
+        { window: 2 },
+      ),
+    );
+    specimen.expect(commits(events)).toEqual(["count to", "three now"]);
+    specimen.expect(events.at(-1)).toEqual({ nature: "final", transcript: "count to three now" });
+  });
+
+  specimen.it("state resets across turns on one stream", async () => {
+    const events = await collect(
+      verbatim.harmonize(
+        script([
+          { nature: "turn.start" },
+          partial("first utterance"),
+          { nature: "final", transcript: "first utterance" },
+          { nature: "turn.end" },
+          { nature: "turn.start" },
+          partial("second"),
+          partial("second thought"),
+          { nature: "final", transcript: "second thought" },
+          { nature: "turn.end" },
+        ]),
+        { window: 2 },
+      ),
+    );
+    specimen.expect(commits(events)).toEqual(["first utterance", "second", "thought"]);
+    specimen.expect(events.filter((e) => e.nature === "turn.end").length).toBe(2);
+  });
+
+  specimen.it("caps the volatile tail", async () => {
+    const long = "one two three four five six seven eight nine ten";
+    const events = await collect(
+      verbatim.harmonize(script([partial(long)]), { window: 2, tail: 3 }),
+    );
+    specimen.expect(partials(events)[0]).toBe("eight nine ten");
+  });
+
+  specimen.it("passes eager, resume, and polish through untouched", async () => {
+    const events = await collect(
+      verbatim.harmonize(
+        script([
+          { nature: "eager", transcript: "hello there" },
+          { nature: "resume" },
+          { nature: "polish", transcript: "Hello there." },
+        ]),
+      ),
+    );
+    specimen.expect(events.map((e) => e.nature)).toEqual(["eager", "resume", "polish"]);
+  });
+
+  specimen.it("commits plus final stay consistent", async () => {
+    const hypotheses = ["so", "so the", "so the plan", "so the plan is", "so the plan is simple"];
+    const events = await collect(
+      verbatim.harmonize(
+        script([
+          ...hypotheses.map(partial),
+          { nature: "final", transcript: "so the plan is simple" },
+        ]),
+        { window: 2 },
+      ),
+    );
+    specimen.expect(commits(events).join(" ")).toBe("so the plan is simple");
+  });
+});
+
+specimen.describe("belt.verbatim.fold — client reduction", () => {
+  const view = ({ committed, tail }) => ({ committed, tail });
+
+  specimen.it("folds commit, partial, final, polish", () => {
+    let state = verbatim.fold(undefined, { nature: "turn.start" });
+    state = verbatim.fold(state, { nature: "commit", text: "hello" });
+    state = verbatim.fold(state, { nature: "partial", transcript: "wor" });
+    specimen.expect(view(state)).toEqual({ committed: "hello", tail: "wor" });
+    state = verbatim.fold(state, { nature: "commit", text: "world" });
+    specimen.expect(view(state)).toEqual({ committed: "hello world", tail: "" });
+    state = verbatim.fold(state, { nature: "final", transcript: "hello world" });
+    specimen.expect(view(state)).toEqual({ committed: "hello world", tail: "" });
+    state = verbatim.fold(state, { nature: "polish", transcript: "Hello, world." });
+    specimen.expect(state.committed).toBe("Hello, world.");
+  });
+
+  specimen.it("keeps every settled segment: a second final appends, a polish repairs only its own", () => {
+    let state = verbatim.fold(undefined, { nature: "turn.start" });
+    state = verbatim.fold(state, { nature: "commit", text: "the quick" });
+    state = verbatim.fold(state, { nature: "final", transcript: "the quick fox" });
+    state = verbatim.fold(state, { nature: "polish", transcript: "The quick fox." });
+    state = verbatim.fold(state, { nature: "commit", text: "jumps" });
+    specimen.expect(view(state)).toEqual({ committed: "The quick fox. jumps", tail: "" });
+    state = verbatim.fold(state, { nature: "partial", transcript: "over the" });
+    specimen.expect(view(state)).toEqual({ committed: "The quick fox. jumps", tail: "over the" });
+    state = verbatim.fold(state, { nature: "final", transcript: "jumps over the dog" });
+    specimen.expect(view(state)).toEqual({ committed: "The quick fox. jumps over the dog", tail: "" });
+    state = verbatim.fold(state, { nature: "polish", transcript: "Jumps over the dog." });
+    specimen.expect(state.committed).toBe("The quick fox. Jumps over the dog.");
+    state = verbatim.fold(state, { nature: "turn.end" });
+    state = verbatim.fold(state, { nature: "turn.start" });
+    state = verbatim.fold(state, { nature: "partial", transcript: "and" });
+    specimen.expect(view(state)).toEqual({ committed: "The quick fox. Jumps over the dog.", tail: "and" });
+  });
+
+  specimen.it("drops a polish that arrives after the next segment opened", () => {
+    let state = verbatim.fold(undefined, { nature: "final", transcript: "one" });
+    state = verbatim.fold(state, { nature: "commit", text: "two" });
+    state = verbatim.fold(state, { nature: "polish", transcript: "One." });
+    specimen.expect(state.committed).toBe("one two");
+  });
+});
