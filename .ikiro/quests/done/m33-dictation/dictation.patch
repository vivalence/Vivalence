index 0000000..6f85feb
--- /dev/null
+++ b/subsystems/typology/tests/dictation.conversation.test.js
@@ -0,0 +1,174 @@
+import { specimen, v, Cortex, shard, Context } from "@vivalence/typology";
+import { Verbatim, Speech } from "../schematics/primitives/hallucination.js";
+
+const invalid = (schema, value) => [...v.errors(schema, value)].length > 0;
+
+specimen.describe("Verbatim + Speech schema families", () => {
+  specimen.it("accepts every verbatim nature", () => {
+    const events = [
+      { nature: "turn.start" },
+      { nature: "commit", text: "hello" },
+      { nature: "partial", transcript: "wor" },
+      { nature: "eager", transcript: "hello world" },
+      { nature: "resume" },
+      { nature: "final", transcript: "hello world", words: [{ word: "hello", start: 0, end: 0.4, confidence: 0.98, language: "en" }] },
+      { nature: "polish", transcript: "Hello, world." },
+      { nature: "turn.end", meta: { reason: "utterance" } },
+    ];
+    for (const event of events) specimen.expect(invalid(Verbatim.Any, event)).toBe(false);
+  });
+
+  specimen.it("rejects unknown natures and missing fields", () => {
+    specimen.expect(invalid(Verbatim.Any, { nature: "mystery" })).toBe(true);
+    specimen.expect(invalid(Verbatim.Any, { nature: "commit" })).toBe(true);
+    specimen.expect(invalid(Verbatim.Any, { nature: "final" })).toBe(true);
+  });
+
+  specimen.it("speech packets demand a rate", () => {
+    specimen.expect(invalid(Speech.Any, { nature: "packet", audio: "aGk=", rate: 24000 })).toBe(false);
+    specimen.expect(invalid(Speech.Any, { nature: "packet", audio: "aGk=" })).toBe(true);
+    specimen.expect(invalid(Speech.Any, { nature: "close" })).toBe(false);
+  });
+});
+
+function scriptedFaculty(hypotheses, final) {
+  return {
+    type:     "verbatim",
+    tune:     [0.4, 0.6, 0.5, 0.1],
+    context:  0,
+    channels: { in: [{ type: "audio", codec: "pcm_16000" }], out: [{ type: "event" }] },
+    via: {
+      stream: async function* (audioSource) {
+        yield { nature: "turn.start" };
+        let index = 0;
+        for await (const _ of audioSource) {
+          if (index < hypotheses.length) yield { nature: "partial", transcript: hypotheses[index++] };
+        }
+        while (index < hypotheses.length) yield { nature: "partial", transcript: hypotheses[index++] };
+        yield { nature: "final", transcript: final };
+        yield { nature: "turn.end" };
+      },
+    },
+  };
+}
+
+function fastDialogue(correct) {
+  return {
+    type:     "dialogue",
+    tune:     [0.1, 0.3, 1.0, 0.9],
+    context:  1000,
+    channels: { in: ["text"], out: ["text"] },
+    via: {
+      render: async ({ turns }) => ({
+        role:  "assistant",
+        parts: [{ type: "text", text: correct(turns.at(-1).parts[0].text) }],
+        meta:  { state: "complete" },
+      }),
+    },
+  };
+}
+
+async function* upstream(chunks) {
+  const encoder = new TextEncoder();
+  for (const chunk of chunks) {
+    yield encoder.encode(`data: ${JSON.stringify({ audio: chunk, pts: 1 })}\n\n`);
+  }
+}
+
+const readable = (iterable) => {
+  const iterator = iterable[Symbol.asyncIterator]();
+  return new ReadableStream({
+    async pull(controller) {
+      const { value, done } = await iterator.next();
+      if (done) return controller.close();
+      controller.enqueue(value);
+    },
+  });
+};
+
+async function pipeline({ vocal = {}, hypotheses, final, correct }) {
+  const cortex = new Cortex().register([
+    scriptedFaculty(hypotheses, final),
+    fastDialogue(correct ?? ((text) => text)),
+  ]);
+  const ctx = new Context({ request: { url: "http://socket/harness/verbatim/stream" } });
+  ctx.request.raw = { body: readable(upstream(["oi", "tudo", "bem"])) };
+  ctx.daemon = { cortex };
+  ctx.vocal = vocal;
+  await shard.hal.verbatim()(ctx);
+  const events = [];
+  for await (const event of ctx.output) events.push(event);
+  return events;
+}
+
+specimen.describe("dictation flow — hal.verbatim over the cortex", () => {
+  specimen.it("yields turn.start, commits, partials, final, polish, turn.end in order", async () => {
+    const events = await pipeline({
+      hypotheses: ["hello", "hello wor", "hello world how"],
+      final:      "hello world how are you",
+      correct:    (text) => text[0].toUpperCase() + text.slice(1) + "?",
+    });
+
+    const natures = events.map((event) => event.nature);
+    specimen.expect(natures[0]).toBe("turn.start");
+    specimen.expect(natures.at(-1)).toBe("turn.end");
+    specimen.expect(natures.indexOf("final")).toBeLessThan(natures.indexOf("polish"));
+    specimen.expect(natures.indexOf("polish")).toBeLessThan(natures.indexOf("turn.end"));
+
+    const polish = events.find((event) => event.nature === "polish");
+    specimen.expect(polish.transcript).toBe("Hello world how are you?");
+
+    for (const event of events) {
+      specimen.expect([...v.errors(Verbatim.Any, event)].length).toBe(0);
+    }
+  });
+
+  specimen.it("commits are append-only and consistent with final", async () => {
+    const events = await pipeline({
+      hypotheses: ["so the", "so the plan", "so the plan is"],
+      final:      "so the plan is simple",
+      vocal:      { polish: false },
+    });
+    const committed = events
+      .filter((event) => event.nature === "commit")
+      .map((event) => event.text)
+      .join(" ");
+    specimen.expect(committed).toBe("so the plan is simple");
+    specimen.expect(events.some((event) => event.nature === "polish")).toBe(false);
+  });
+
+  specimen.it("polish failure degrades silently, final intact", async () => {
+    const cortex = new Cortex().register([
+      scriptedFaculty(["hi"], "hi there"),
+      {
+        type:     "dialogue",
+        tune:     [0.1, 0.3, 1.0, 0.9],
+        context:  1000,
+        channels: { in: ["text"], out: ["text"] },
+        via:      { render: async () => { throw new Error("provider down"); } },
+      },
+    ]);
+    const ctx = new Context({ request: { url: "http://socket/harness/verbatim/stream" } });
+    ctx.request.raw = { body: readable(upstream(["hi"])) };
+    ctx.daemon = { cortex };
+    ctx.vocal = {};
+    await shard.hal.verbatim()(ctx);
+    const events = [];
+    for await (const event of ctx.output) events.push(event);
+    specimen.expect(events.find((event) => event.nature === "final").transcript).toBe("hi there");
+    specimen.expect(events.some((event) => event.nature === "polish")).toBe(false);
+    specimen.expect(events.at(-1).nature).toBe("turn.end");
+  });
+
+  specimen.it("VOCAL harmonize options reach the harmonizer", async () => {
+    const loose = await pipeline({
+      hypotheses: ["one two three four five", "one two three four five six"],
+      final:      "one two three four five six",
+      vocal:      { polish: false, harmonize: { tail: 2 } },
+    });
+    const partials = loose.filter((event) => event.nature === "partial");
+    for (const event of partials) {
+      specimen.expect(event.transcript.split(" ").length <= 2).toBe(true);
+    }
+  });
+});
diff --git a/subsystems/typology/tests/harmonize.test.js b/subsystems/typology/tests/harmonize.test.js
