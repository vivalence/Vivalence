+import { specimen, sleep, shape, shard, Url, Connection } from "@vivalence/typology";
+import { create } from "./scenarios/cortex.js";
+import { verbatimFaculty } from "./scenarios/fixtures.js";
+
+function launch(aperture, port = 0) {
+  const gate = shard.serve.multiplex(aperture);
+  aperture.open("/multiplex", gate);
+  const abort = new AbortController();
+  const server = Deno.serve({ port, signal: abort.signal, onListen() {} }, shape.http(aperture));
+  return {
+    gate,
+    abort,
+    port: server.addr.port,
+    url: new Url(`http://localhost:${server.addr.port}`),
+  };
+}
+
+async function* frames(chunks) {
+  for (const chunk of chunks) yield { audio: chunk, pts: 1 };
+}
+
+async function drain(source) {
+  const events = [];
+  for await (const event of source) events.push(event);
+  return events;
+}
+
+const natures = (events) => events.map((event) => event.nature);
+const commits = (events) => events.filter((e) => e.nature === "commit").map((e) => e.text);
+
+let scenario;
+let world;
+let transport;
+let connection;
+let harness;
+
+specimen.describe("dictation integration — duplex verbatim over one socket", () => {
+  specimen.beforeAll(async () => {
+    scenario = await create();
+    scenario.cortex.register([verbatimFaculty()]);
+    world = launch(scenario.daemon.aperture);
+    await sleep.ms(100);
+    transport = shard.transmitter.multiplex({ authority: { get: () => ({ access: "probe" }) } });
+    connection = new Connection(world.url, transport);
+    harness = connection.branch(scenario.dewey.mount.absolute).branch("/harness");
+  });
+
+  specimen.afterAll(async () => {
+    transport.close();
+    await sleep.ms(200);
+    world.abort.abort();
+    await sleep.ms(20);
+    await scenario.orm.close();
+  });
+
+  specimen.it("audio frames up, harmonized events down, polish before turn.end", async () => {
+    const thread = await scenario.createThread();
+    const events = await drain(
+      await harness.publish(
+        `/verbatim/stream?thread=${thread.id}`,
+        frames(["one", "two", "three"]),
+        { stream: true },
+      ),
+    );
+
+    const kinds = natures(events);
+    specimen.expect(kinds[0]).toBe("turn.start");
+    specimen.expect(kinds.at(-1)).toBe("turn.end");
+    specimen.expect(kinds.filter((n) => n === "partial").length).toBe(3);
+    specimen.expect(commits(events).join(" ")).toBe("one two three");
+
+    const final = events.find((event) => event.nature === "final");
+    specimen.expect(final.transcript).toBe("one two three");
+
+    const polishAt = kinds.indexOf("polish");
+    specimen.expect(polishAt).toBeGreaterThan(kinds.indexOf("final"));
+    specimen.expect(polishAt).toBeLessThan(kinds.indexOf("turn.end"));
+  });
+
+  specimen.it("thread.trait.VOCAL projects into the pipeline", async () => {
+    const thread = await scenario.createThread();
+    thread.traits = ["VOCAL"];
+    thread.trait = { VOCAL: { harmonize: { tail: 1 }, polish: false } };
+    await scenario.em.flush();
+
+    const events = await drain(
+      await harness.publish(
+        `/verbatim/stream?thread=${thread.id}`,
+        frames(["alpha", "beta", "gamma"]),
+        { stream: true },
+      ),
+    );
+
+    for (const event of events.filter((e) => e.nature === "partial")) {
+      specimen.expect(event.transcript.split(" ").filter(Boolean).length <= 1).toBe(true);
+    }
+    specimen.expect(events.some((event) => event.nature === "polish")).toBe(false);
+  });
+
+  specimen.it("abort mid-stream leaves no orphan frames on the socket", async () => {
+    const thread = await scenario.createThread();
+    const controller = new AbortController();
+
+    async function* trickle() {
+      yield { audio: "only", pts: 1 };
+      await sleep.ms(30);
+      controller.abort();
+      await sleep.ms(1000);
+    }
+
+    const settled = (async () => {
+      try {
+        await drain(
+          await harness.publish(`/verbatim/stream?thread=${thread.id}`, trickle(), {
+            stream: true,
+            signal: controller.signal,
+          }),
+        );
+      } catch {}
+    })();
+
+    await settled;
+    await sleep.ms(200);
+    for (const socket of world.gate.sockets) {
+      specimen.expect(socket.lines.size).toBe(0);
+    }
+  });
+});
