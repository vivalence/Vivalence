diff --git a/systems/kajuit/src/app/panels/a/widgets/Dictaphone.svelte b/systems/kajuit/src/app/panels/a/widgets/Dictaphone.svelte
new file mode 100644
index 0000000..cf570e8
--- /dev/null
+++ b/systems/kajuit/src/app/panels/a/widgets/Dictaphone.svelte
@@ -0,0 +1,131 @@
+<script>
+  import { onDestroy } from "svelte";
+  import { dictation } from "@vivalence/kajuit";
+
+  let { terminal, box, disabled = false, onsplice, onghost } = $props();
+
+  const dictaphone = dictation({ terminal, box });
+  const { $active, $committed, $tail, $error } = dictaphone;
+
+  let level = $state(0);
+  let unlevel = null;
+
+  let phase = $state("idle");
+  let committed = $state("");
+  let tail = $state("");
+  let fault = $state(null);
+
+  const shadow = () => onghost?.({ committed, tail, active: phase !== "idle" });
+
+  const unsubs = [
+    $active.subscribe((value) => {
+      phase = value;
+      if (value === "listening") {
+        unlevel = box.device.microphone.$level.subscribe((v) => (level = v));
+      } else {
+        unlevel?.();
+        unlevel = null;
+        level = 0;
+      }
+      if (value === "idle" && (committed || tail)) {
+        const settled = committed;
+        committed = "";
+        tail = "";
+        shadow();
+        onsplice?.(settled);
+        return;
+      }
+      shadow();
+    }),
+    $committed.subscribe((value) => ((committed = value), shadow())),
+    $tail.subscribe((value) => ((tail = value), shadow())),
+    $error.subscribe((value) => (fault = value)),
+  ];
+
+  function toggle() {
+    if (phase === "idle") dictaphone.start();
+    else if (phase === "listening") dictaphone.stop();
+  }
+
+  export function cancel() {
+    dictaphone.cancel();
+    committed = "";
+    tail = "";
+    shadow();
+  }
+
+  export const listening = () => phase !== "idle";
+
+  onDestroy(() => {
+    for (const unsub of unsubs) unsub();
+    unlevel?.();
+    dictaphone.teardown();
+  });
+</script>
+
+<button
+  class="dictaphone"
+  class:listening={phase === "listening"}
+  class:settling={phase === "settling" || phase === "arming"}
+  onclick={toggle}
+  onpointerdown={(event) => event.preventDefault()}
+  disabled={disabled || phase === "settling" || phase === "arming"}
+  title={fault ?? (phase === "listening" ? "settle dictation" : "dictate")}
