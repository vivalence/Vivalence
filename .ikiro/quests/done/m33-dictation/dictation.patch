@@ -0,0 +1,26 @@
+export function encode(samples) {
+  const clamped = new Int16Array(samples.length);
+  for (let i = 0; i < samples.length; i++) {
+    const s = Math.max(-1, Math.min(1, samples[i]));
+    clamped[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
+  }
+  const view = new Uint8Array(clamped.buffer);
+  let binary = "";
+  for (let i = 0; i < view.length; i++) binary += String.fromCharCode(view[i]);
+  return btoa(binary);
+}
+
+export function bytes(audio) {
+  if (audio instanceof Uint8Array) return audio;
+  return Uint8Array.from(atob(audio), (c) => c.charCodeAt(0));
+}
+
+export function decode(audio) {
+  const raw = bytes(audio);
+  const ints = new Int16Array(raw.buffer, raw.byteOffset, Math.floor(raw.byteLength / 2));
+  const samples = new Float32Array(ints.length);
+  for (let i = 0; i < ints.length; i++) {
+    samples[i] = ints[i] < 0 ? ints[i] / 0x8000 : ints[i] / 0x7fff;
+  }
+  return samples;
+}
diff --git a/subsystems/typology/gestalten/belt/sse.js b/subsystems/typology/gestalten/belt/sse.js
new file mode 100644
index 0000000..9fa29ce
--- /dev/null
+++ b/subsystems/typology/gestalten/belt/sse.js
@@ -0,0 +1,30 @@
+const decoder = new TextDecoder();
+
+export async function* frames(readable) {
+  const reader = readable.getReader();
+  let buffer = "";
+  try {
+    while (true) {
+      const { value, done } = await reader.read();
+      if (done) break;
+      buffer += typeof value === "string" ? value : decoder.decode(value, { stream: true });
+      let boundary;
+      while ((boundary = buffer.indexOf("\n\n")) !== -1) {
+        const frame = buffer.slice(0, boundary);
+        buffer = buffer.slice(boundary + 2);
+        for (const line of frame.split("\n")) {
+          if (!line.startsWith("data:")) continue;
+          const payload = line.slice(5).trim();
+          if (!payload) continue;
+          try {
+            yield JSON.parse(payload);
+          } catch {
+            yield payload;
+          }
+        }
+      }
+    }
+  } finally {
+    reader.releaseLock();
+  }
+}
diff --git a/subsystems/typology/gestalten/belt/verbatim.js b/subsystems/typology/gestalten/belt/verbatim.js
new file mode 100644
index 0000000..1175d05
--- /dev/null
+++ b/subsystems/typology/gestalten/belt/verbatim.js
@@ -0,0 +1,108 @@
+import { similarity } from "./string.js";
+
+export const defaults = { window: 2, tolerance: 0.8, tail: 8 };
+
+const bare = (word) => word.toLowerCase().replace(/[^\p{L}\p{N}]/gu, "");
+
+export function wordsAgree(a, b, tolerance = defaults.tolerance) {
+  const left = bare(a);
+  const right = bare(b);
+  if (left === right) return true;
+  return similarity(left, right) >= tolerance;
+}
+
+const tokens = (transcript) => (transcript ?? "").trim().split(/\s+/).filter(Boolean);
+
+function frontier(ring, committed, tolerance) {
+  const limit = Math.min(...ring.map((hypothesis) => hypothesis.length));
+  let index = committed;
+  while (index < limit) {
+    const anchor = ring.at(-1)[index];
+    if (!ring.every((hypothesis) => wordsAgree(hypothesis[index], anchor, tolerance))) break;
+    index += 1;
+  }
+  return index;
+}
+
+export async function* harmonize(events, options = {}) {
+  const { window, tolerance, tail } = { ...defaults, ...options };
+  let committed = 0;
+  let ring = [];
+
+  const reset = () => {
+    committed = 0;
+    ring = [];
+  };
+
+  for await (const event of events) {
+    switch (event.nature) {
+      case "turn.start": {
+        reset();
+        yield event;
+        break;
+      }
+      case "partial": {
+        const hypothesis = tokens(event.transcript);
+        ring = [...ring, hypothesis].slice(-window);
+        if (ring.length === window) {
+          const settled = frontier(ring, committed, tolerance);
+          if (settled > committed) {
+            yield { nature: "commit", text: hypothesis.slice(committed, settled).join(" ") };
+            committed = settled;
+          }
+        }
+        const volatile = hypothesis.slice(committed);
+        yield { nature: "partial", transcript: volatile.slice(-tail).join(" ") };
+        break;
+      }
+      case "final": {
+        const settled = tokens(event.transcript);
+        const remainder = settled.slice(committed);
+        if (remainder.length) yield { nature: "commit", text: remainder.join(" ") };
+        yield event;
+        reset();
+        break;
+      }
+      case "turn.end": {
+        reset();
+        yield event;
+        break;
+      }
+      default:
+        yield event;
+    }
+  }
+}
+
+const join = (...parts) => parts.filter(Boolean).join(" ");
+
+export const empty = { committed: "", tail: "", settled: "", segment: "", closed: false };
+
+const advance = (state) =>
+  state.closed ? { ...state, settled: join(state.settled, state.segment), segment: "", closed: false } : state;
+
+const settle = (state, patch) => {
+  const next = { ...state, ...patch };
+  return { ...next, committed: join(next.settled, next.segment) };
+};
+
+export function fold(state = empty, event) {
+  switch (event.nature) {
+    case "turn.start":
+      return settle(advance(state), { tail: "" });
+    case "commit": {
+      const open = advance(state);
+      return settle(open, { segment: join(open.segment, event.text), tail: "" });
+    }
+    case "partial":
+      return settle(advance(state), { tail: event.transcript });
+    case "final": {
+      const open = advance(state);
+      return settle(open, { segment: event.transcript, tail: "", closed: true });
+    }
+    case "polish":
+      return state.closed ? settle(state, { segment: event.transcript, tail: "" }) : state;
+    default:
+      return state;
+  }
+}
