diff --git a/systems/kajuit/src/typology/prototypes/dictation.js b/systems/kajuit/src/typology/prototypes/dictation.js
new file mode 100644
index 0000000..a1db21f
--- /dev/null
+++ b/systems/kajuit/src/typology/prototypes/dictation.js
@@ -0,0 +1,97 @@
+import { atom } from "nanostores";
+import { verbatim } from "@vivalence/typology";
+
+export function dictation({ terminal, box }) {
+  const $active = atom("idle");
+  const $committed = atom("");
+  const $tail = atom("");
+  const $error = atom(null);
+
+  let feed = null;
+  let link = null;
+  let settle = null;
+
+  async function* frames(signal) {
+    const microphone = box.device.microphone;
+    for await (const samples of microphone.in.stream(signal)) {
+      yield { audio: box.drivers.audio.encode(samples), pts: Date.now() };
+    }
+  }
+
+  async function reduce(events) {
+    let state = verbatim.empty;
+    try {
+      for await (const event of events) {
+        state = verbatim.fold(state, event);
+        $committed.set(state.committed);
+        $tail.set(state.tail);
+      }
+    } catch (error) {
+      if (error.name !== "AbortError") $error.set(error.message);
+    } finally {
+      box.device.microphone.release();
+      feed = null;
+      link = null;
+      $tail.set("");
+      $active.set("idle");
+    }
+  }
+
+  async function start() {
+    if ($active.get() !== "idle") return;
+    $error.set(null);
+    $committed.set("");
+    $tail.set("");
+    $active.set("arming");
+    try {
+      await box.device.microphone.claim();
+    } catch (error) {
+      $error.set(error.message);
+      $active.set("idle");
+      return;
+    }
+    feed = new AbortController();
+    link = new AbortController();
+    const thread = terminal.thread;
+    const events = await thread.mode.connection.publish(
+      `/harness/verbatim/stream?thread=${thread.id}`,
+      frames(feed.signal),
+      { stream: true, signal: link.signal },
+    );
+    $active.set("listening");
+    settle = reduce(events);
+  }
+
+  function stop() {
+    if ($active.get() !== "listening") return;
+    $active.set("settling");
+    feed?.abort();
+    box.device.microphone.pause();
+  }
+
+  function cancel() {
+    feed?.abort();
+    link?.abort();
+    box.device.microphone.release();
+    $committed.set("");
+    $tail.set("");
+    $active.set("idle");
+  }
+
+  const unswitch = terminal.$thread.subscribe(() => cancel());
+
+  return {
+    $active,
+    $committed,
+    $tail,
+    $error,
+    start,
+    stop,
+    cancel,
+    settled: () => settle,
+    teardown: () => {
+      cancel();
+      unswitch();
+    },
+  };
+}
