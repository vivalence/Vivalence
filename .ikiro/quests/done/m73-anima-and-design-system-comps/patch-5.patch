+    border-radius: var(--shape-radius-key);
+    background: var(--surface-sunk);
+    box-shadow: inset 0 0 0 var(--size-ring) var(--boundary);
+  }
+  .harness-tile-name {
+    overflow: hidden;
+    text-overflow: ellipsis;
