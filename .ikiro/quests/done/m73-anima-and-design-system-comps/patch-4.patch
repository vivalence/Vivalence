+  });
+
+  specimen.it("the meta bar opens its three chips; a chip latches and hands its name up — the dock itself opens no console", () => {
+    const heard = [];
+    const { target, key } = dock(world({ turns: HISTORY }), { onconsole: (name) => heard.push(name) });
