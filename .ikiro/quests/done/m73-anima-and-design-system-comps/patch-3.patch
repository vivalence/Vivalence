+  letter-spacing: 0.06em;
+  text-transform: lowercase;
+  cursor: pointer;
+  opacity: 0.55;
+  transition: opacity 0.12s, border-color 0.12s, color 0.12s;
+}
+section .act:hover:not(:disabled) {
+  opacity: 1;
+  border-color: var(--signal-primary);
+  color: var(--signal-primary-ink);
+}
+section .act.on {
+  opacity: 1;
+  border-color: var(--signal-primary);
+  color: var(--signal-primary-ink);
+}
+section .act.danger:hover:not(:disabled) {
+  border-color: var(--signal-negative);
+  color: var(--signal-negative-ink);
+}
+section .act:disabled { opacity: 0.25; cursor: not-allowed; }
