+
+  let holding = $state(false);
+  let pressed = false;
+  let fired = false;
+  let timer = null;
+
+  const press = (event) => {
+    fired = false;
+    if (disabled) return;
+    pressed = true;
+    onpress?.(event);
+    if (!hold) return;
+    holding = true;
+    timer = setTimeout(() => {
+      fired = true;
+      holding = false;
+      onhold?.();
+    }, hold);
+  };
+
+  const lift = (event) => {
+    clearTimeout(timer);
+    holding = false;
+    if (!pressed) return;
+    pressed = false;
+    onrelease?.(event);
+  };
+
+  const click = (event) => {
+    if (disabled || fired) return;
+    onclick?.(event);
+  };
 </script>
 
