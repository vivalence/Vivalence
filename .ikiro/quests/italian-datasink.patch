new file mode 100644
index 0000000..9926d32
--- /dev/null
+++ b/registry/education/modes/tactics/harvest/belt/audio.js
@@ -0,0 +1,27 @@
+const LOUDNORM = ["-af", "loudnorm=I=-18:TP=-2:LRA=11", "-ar", "44100", "-b:a", "128k"];
+const FLOOR = 4000;
+
+export const normalize = async (raw) => {
+  const inbound = await Deno.makeTempFile();
+  const outbound = await Deno.makeTempFile({ suffix: ".mp3" });
+  try {
+    await Deno.writeFile(inbound, raw);
+    const run = await new Deno.Command("ffmpeg", {
+      args: ["-y", "-i", inbound, ...LOUDNORM, outbound],
+      stderr: "null",
+      stdout: "null",
+    }).output();
+    if (!run.success) return null;
+    const bytes = await Deno.readFile(outbound);
+    return bytes.length < FLOOR ? null : bytes;
+  } finally {
+    await Deno.remove(inbound).catch(() => {});
+    await Deno.remove(outbound).catch(() => {});
+  }
+};
+
+export const pull = async (url, agent) => {
+  const response = await fetch(url, { headers: { "User-Agent": agent } });
+  if (!response.ok) throw new Error(`[pull] ${response.status} ${url}`);
+  return new Uint8Array(await response.arrayBuffer());
+};
