import { secure } from "@vivalence/shared";

export function attachIdentity(aperture) {
  aperture
    .open("/status", (body, ctx) => ({
      status: "identity:/status ok",
      timestamp: new Date().toISOString(),
    }))
    .open("/handshake", async (body, ctx) => {
      const user = await ctx.identity.getUser();
      console.log("user", user);
      return { user };
    })
    .open("/:entity/:method", async (input, ctx) => {
      // console.log("/shard/:entity/:method"); console.log(input, ctx);
      const params = ctx.params;

      if (!["intent"].includes(params.entity))
        throw new Error("unsupported entity");
      if (!["find"].includes(params.method))
        throw new Error("unsupported method");

      const repository =
        ctx.runtime.entities[{ intent: "intents" }[params.entity]];

      let result = {};
      switch (params.method) {
        case "find":
          const user = await ctx.identity.getUser();
          body.where.user = user.id;
          result = await repository.find(body.where, body.options);
      }

      return result;
      // return await ctx.runtime.modules[someModuleManager/EntityMap/RepositorySystem][ctx.params.method](module.type, body.where, body.options);
    });
}
