meta {
  name: find
  type: http
  seq: 7
}

post {
  url: {{IDENTITY_AUTHORITY}}/entities/runtime/find
  body: json
  auth: none
}

body:json {
  {
      "slug": "eng2lat"
    }
}

assert {
  res.body: isJson
}

tests {
  test("should verify valid token", function () {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
  });
   
  test("should return valid flag and identity", function () {
    const data = res.getBody();
    expect(data).to.have.property('valid');
    expect(data.valid).to.equal(true);
  });
  
}
