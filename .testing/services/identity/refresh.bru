meta {
  name: Refresh
  type: http
  seq: 3
}

post {
  url: {{IDENTITY_AUTHORITY}}/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh": "{{refreshToken}}"
  }
}

vars:post-response {
  accessToken: res.body.access
}

assert {
  res.body: isJson
}

tests {
  test("should refresh access token", function () {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
  });
   
  test("should return new access token", function () {
    const data = res.getBody();
    expect(data).to.have.property('access');
    expect(data.access).to.be.a('string');
  });
  
  test("should return different token than original", function () {
    const data = res.getBody();
    expect(data.access).to.not.equal('{{accessToken}}');
  });
}
