meta {
  name: Verify
  type: http
  seq: 2
}

post {
  url: {{IDENTITY_AUTHORITY}}/verify
  body: json
  auth: none
}

body:json {
  {
    "access": "{{accessToken}}"
  }
}

assert {
  res.body: isJson
}

tests {
  test("should verify valid token", function () {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
  });
   
  test("should return valid flag and identity", function () {
    const data = res.getBody();
    expect(data).to.have.property('valid');
    expect(data.valid).to.equal(true);
  });
  
  // test("should return identity details", function () {
  //   const data = res.getBody();
  //   expect(data.identity).to.have.property('id');
  //   expect(data.identity).to.have.property('username');
  //   expect(data.identity).to.have.property('roles');
  // });
}
