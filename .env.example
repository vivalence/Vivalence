# copy to testament/variant/.env and fill in. testament/ is this machine's run surface
# (gitignored wholesale): the ledger (locks/logs/instances/registry records),
# mountpoint dbs, this file.
VIVA_SYSTEM_MODE="DEVELOPMENT"
VIVA_SYSTEM_ROLE="SUDO"

VIVA_REPOSITORY_MOUNT="<absolute repo root>"
VIVA_LEDGER_MOUNT="<repo>/testament/ledger"
VIVA_VARIANT_MOUNT="<repo>/testament/variant"
VIVA_MOUNTPOINT_MOUNT="<repo>/testament/variant/mountpoint"

SECRET_VIVA_JWT=""
SECRET_VIVA_ANTHROPIC_API_KEY=""
SECRET_VIVA_ELEVENLABS_API_KEY=""
SECRET_VIVA_DEEPGRAM_API_KEY=""
SECRET_VIVA_SERVICE_NLP_KEY=""
