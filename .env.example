# copy to testament/instance/.env and fill in. the machine home is ~/.viva by default;
# testament/ pins a repo-local home (gitignored wholesale): the ledger (locks/logs/
# instances/registry records), mountpoint dbs, this file.
# VIVA_INSTANCE_MOUNT also accepts a bare slug, resolved to <ledger>/instances/<slug>.
VIVA_SYSTEM_MODE="DEVELOPMENT"
VIVA_SYSTEM_ROLE="SUDO"

VIVA_REPOSITORY_MOUNT="<absolute repo root>"
VIVA_LEDGER_MOUNT="<repo>/testament/ledger"
VIVA_INSTANCE_MOUNT="<repo>/testament/instance"
VIVA_MOUNTPOINT_MOUNT="<repo>/testament/instance/mountpoint"

SECRET_VIVA_JWT=""
SECRET_VIVA_ANTHROPIC_API_KEY=""
SECRET_VIVA_ELEVENLABS_API_KEY=""
SECRET_VIVA_DEEPGRAM_API_KEY=""
SECRET_VIVA_SERVICE_NLP_KEY=""
