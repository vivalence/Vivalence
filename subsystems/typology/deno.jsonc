{
  "name": "@vivalence/typology",
  "version": "0.0.1",
  "exports": {
    ".": "./mod.ts",
    "./prototypes": "./prototypes/index.ts",
    "./schematics": "./schematics/index.js",
    "./gestalten": "./gestalten/index.js",
