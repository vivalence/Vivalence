meta {
  name: expect
  type: http
  seq: 2
}

post {
  url: {{PUBLIC_VIVA_LIGHTHOUSE_REMOTE}}/entities/daemon/expect
  body: json
  auth: none
}

body:json {
  {
       "where": {
          "slug": "brazilian",
          "url": "https://runtime.s4y.vivalence.com/daemon/brazilian"
        }
    }
}

assert {
  res.body: isJson
}

tests {
  test("should verify valid token", function () {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
  });
   
  test("should return valid flag and identity", function () {
    const data = res.getBody();
    expect(data).to.have.property('valid');
    expect(data.valid).to.equal(true);
  });
  
}
