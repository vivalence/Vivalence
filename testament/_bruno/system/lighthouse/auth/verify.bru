meta {
  name: Verify
  type: http
  seq: 3
}

post {
  url: {{PUBLIC_VIVA_LIGHTHOUSE_REMOTE}}/auth/verify
  body: json
  auth: none
}

body:json {
  {
    "access": "{{accessToken}}"
  }
}

assert {
  res.body: isJson
}

tests {
  test("should verify valid token", function () {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
  });
   
  test("should return valid flag and identity", function () {
    const data = res.getBody();
    expect(data).to.have.property('valid');
    expect(data.valid).to.equal(true);
  });
  
}
