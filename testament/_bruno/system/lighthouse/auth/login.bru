meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{PUBLIC_VIVA_LIGHTHOUSE_REMOTE}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "beef",
    "password": "biggusdickus"
  }
}

vars:post-response {
  accessToken: res.body.authority.access
  refreshToken: res.body.authority.refresh
  identityId: res.body.identity.id
}

assert {
  res.body: isJson
}

tests {
  test("should be able to login", function () {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
  });
   
}
