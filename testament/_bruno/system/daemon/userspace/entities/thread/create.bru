meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{DAEMON}}/userspace/entities/thread/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "data": {
      "mode": "{{DEWEY_MODE_ID}}"
    }
  }
}

tests {
  test("thread created successfully", function () {
    const thread = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(thread.id).to.be.a('string');
    bru.setVar('DEWEY_THREAD_ID', thread.id);
  });
}
