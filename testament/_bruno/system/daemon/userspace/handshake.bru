meta {
  name: handshake
  type: http
  seq: 7
}

post {
  url: {{DAEMON}}/userspace/handshake
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {}
}

assert {
  res.body: isJson
}

tests {
  test("should return user details", function () {
    const data = res.getBody();
    expect(data.user).to.have.property('id');
  });
}
