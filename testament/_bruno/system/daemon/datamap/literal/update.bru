meta {
  name: update
  type: http
  seq: 8
}

post {
  url: {{DAEMON}}/entities/literal/update
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "where": {
      "traits": {
        "$contains": ["VOCALIZED"]
      }
    },
    "data": {
      "trait": {
        "VOCALIZED": null
      }
    }
  }
}
