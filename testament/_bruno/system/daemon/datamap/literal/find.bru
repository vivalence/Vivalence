meta {
  name: find
  type: http
  seq: 1
}

post {
  url: {{DAEMON}}/entities/literal/find
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "where": {
      "symbols": [
        "word",
        "proficiency.survival"
      ]
    },
    "options": {
      "populate": [
        "symbols"
      ],
      "limit": 10
    }
  }
}
