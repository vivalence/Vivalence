meta {
  name: findOne
  type: http
  seq: 2
}

post {
  url: {{DAEMON}}/entities/mode/findOne
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "where": {
      "type": "teacher",
      "slug": "dewey"
    }
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

tests {
  test("mode found — store ID", function () {
    const mode = res.getBody();
    expect(mode.id).to.be.a('string');
    bru.setVar('DEWEY_MODE_ID', mode.id);
  });
}
