meta {
  name: update
  type: http
  seq: 8
}

post {
  url: {{DAEMON}}/entities/mode/update
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "where": {
      "type": {
        "$in": ["game", "topology"]
      }
    },
    "data": {
      "installed": false
    }
  }
}
