meta {
  name: find
  type: http
  seq: 1
}

post {
  url: {{DAEMON}}/entities/symbol/find
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "where": {
      "$or": [
        {
          "slug": "word"
        },
        {
          "slug": "proficiency.survival"
        }
      ]
    },
    "options": {
      "populate": [
        "literals"
      ],
      "limit": 1
    }
  }
}
