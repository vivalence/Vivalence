          "translations": {
            "id": "877e1133-477a-4739-9eea-f74676381fb8",
            "createdAt": "2024-10-25T18:45:45.965",
            "updatedAt": "2024-10-25T18:45:45.965",
            "name": "Translations",
            "installed": true,
            "version": "0.0.2",
            "runtimeId": "92d1ace6-146e-4b8d-a5ef-5882eaaa9477",
            "slug": "translations",
            "mask": {
              "prompt": {
                "goal": "### Task:\nCreate simple sentence to practice.\n\n### Instructions:\nChoose common, everyday nouns suitable for beginner level language learners.\nThe statement must make sense, possibly occur in written text or conversation, and be clear for a language learner.\n"
              }
            },
            "description": "Practice translating sentences"
          }
        }
      },
      "runtimeId": "92d1ace6-146e-4b8d-a5ef-5882eaaa9477",
      "masks": {
        "prose": {
          "prompt": {
            "goal": "The reader is a language learner that is practicing sentence translations with focus on a specific grammatical concept.\nGenerate clear, beginner-friendly language learning content explaining a specific grammatical feature.\nUse simple language to explain the concept, plenty of examples, and visual aids.\nAssume the reader is an absolute beginner encountering this grammatical aspect for the first time.\nAround 150 words or 2 paragraphs.\n"
          }
        },
        "flashcards": {
          "status": [
            null,
            "UNTOUCHED",
            "UNKNOWN"
          ]
        },
        "translations": {
          "prompt": {
            "goal": "\nThe user is practicing the usage of Articles in spanish.\nThe article must agree and be demonstrated.\nYour task is to create a very very short and simple sentence,\n using specific vocabulary and following grammatical constraints.\n\nYou're given a list of nouns, which serves as the available vocabulary. \nYou're given grammatical constraints for: definiteness, gender, and number. \nThe sentence must be simple, because a A1 language learner will translate that sentence for practice.\nImportant: the sentence must follow the provided grammar and vocabulary.\nAim for 2 to 4 words for the sentence.\n"
          }
        }
      },
      "slug": "article-practice",
      "description": null,
      "installed": true,
      "version": "0.0.3"
    },
