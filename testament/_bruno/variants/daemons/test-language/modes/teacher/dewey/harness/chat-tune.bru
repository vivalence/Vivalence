meta {
  name: chat with tune
  type: http
  seq: 3
}

post {
  url: {{TEACHER_DEWEY}}/harness/dialogue/stream
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "thread": "{{DEWEY_THREAD_ID}}",
    "parts": [{ "type": "text", "text": "Explique a diferença entre ser e estar, com exemplos detalhados." }],
    "tune": "unleashed"
  }
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains text/event-stream
}

tests {
  test("SSE stream contains full turn lifecycle", function () {
    const body = res.getBody();
    expect(body).to.contain('"event":"turn.open"');
    expect(body).to.contain('"event":"part.close"');
    expect(body).to.contain('"event":"turn.close"');
  });

  test("unleashed tune returns rich content — many deltas", function () {
    const body = res.getBody();
    const deltaCount = (body.match(/"event":"part\.delta"/g) || []).length;
    expect(deltaCount).to.be.greaterThan(20);
  });

  test("response addresses ser vs estar distinction", function () {
    const body = res.getBody();
    expect(body.toLowerCase()).to.satisfy(t => t.includes('ser') && t.includes('estar'));
  });
}
