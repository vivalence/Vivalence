meta {
  name: conversation
  type: ws
  seq: 1
}

ws {
  url: {{WS_TEACHER_DEWEY}}/conversation?token={{accessToken}}
  body: ws
  auth: none
}

body:ws {
  name: 1 — handshake open
  type: json
  content: '''
    {
      "signal": "/handshake/open",
      "input": {
        "shape": {
          "leaves": [],
          "branches": {
            "dialogue": {
              "leaves": [
                { "nature": "packet" },
                { "nature": "close" }
              ],
              "branches": {}
            }
          }
        }
      },
      "echo": "open"
    }
  '''
}

body:ws {
  name: 2 — dialogue open: house
  type: json
  content: '''
    {
      "signal": "/dialogue/open",
      "input": {
        "thread": "{{DEWEY_THREAD_ID}}",
        "parts": [{ "type": "text", "text": "Oi Dewey! Como se diz 'house' em português?" }]
      }
    }
  '''
}
