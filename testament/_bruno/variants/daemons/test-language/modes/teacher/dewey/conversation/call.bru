meta {
  name: call
  type: ws
  seq: 2
}

ws {
  url: {{WS_TEACHER_DEWEY}}/conversation?token={{accessToken}}
  body: ws
  auth: none
}

body:ws {
  name: 1 — handshake open
  type: json
  content: '''
    {
      "signal": "/handshake/open",
      "input": {
        "shape": {
          "leaves": [],
          "branches": {
            "dialogue": {
              "leaves": [
                { "nature": "packet" },
                { "nature": "close" }
              ],
              "branches": {}
            },
            "speech": {
              "leaves": [
                { "nature": "packet" },
                { "nature": "abort" },
                { "nature": "close" }
              ],
              "branches": {}
            },
            "verbatim": {
              "leaves": [
                { "nature": "packet" }
              ],
              "branches": {}
            }
          }
        }
      },
      "echo": "open"
    }
  '''
}

body:ws {
  name: 2 — dialogue open: oi
  type: json
  content: '''
    {
      "signal": "/dialogue/open",
      "input": {
        "thread": "{{DEWEY_THREAD_ID}}",
        "parts": [{ "type": "text", "text": "Oi Dewey!" }]
      }
    }
  '''
}

body:ws {
  name: 3 — verbatim packet (fixture audio)
  type: json
  content: '''
    {
      "signal": "/verbatim/packet",
      "input": {
        "audio": "{{FIXTURE_AUDIO_ULAW_BASE64}}",
        "participantId": "dewey"
      }
    }
  '''
}

body:ws {
  name: 4 — verbatim close
  type: json
  content: '''
    {
      "signal": "/verbatim/close",
      "input": {}
    }
  '''
}

body:ws {
  name: 5 — dialogue abort (barge-in)
  type: json
  content: '''
    {
      "signal": "/dialogue/abort",
      "input": {}
    }
  '''
}

docs {
  # Voice call (env-gated)

  Requires real service bindings in circuitry:
  - `SECRET_VIVA_ELEVENLABS_API_KEY`
  - `SECRET_VIVA_DEEPGRAM_API_KEY`

  Preconditions:
  - Dewey manifest has VOCALIZED trait
  - Daemon circuitry binds `speech: @vivalence/speech/elevenlabs`
  - Daemon circuitry binds `verbatim: @vivalence/verbatim/deepgram`
  - Thread seeded with `trait.INSITU.audio.enabled = true` (use `dewey · call` intent)
  - `FIXTURE_AUDIO_ULAW_BASE64` env holds a base64-encoded ulaw_8000 clip saying "oi"

  Expected flow:
  1. Handshake open negotiates audio-family routes.
  2. Dialogue open triggers dual fanout: `/dialogue/packet` (text) AND `/speech/packet` (audio).
  3. Verbatim packet spins per-connection Deepgram stream.
  4. First partial + final arrive within ~600ms for a one-word utterance (delivered as `/verbatim/packet` with `nature` discriminator).
  5. Final transcript triggers internal auto-voice → new `/dialogue/open` → more speech packets.
  6. `/dialogue/abort` kills inflight speech stream cleanly.
}
