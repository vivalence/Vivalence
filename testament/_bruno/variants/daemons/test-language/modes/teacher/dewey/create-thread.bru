meta {
  name: create thread
  type: http
  seq: 2
}

post {
  url: {{DAEMON}}/userspace/entities/thread/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "data": {
      "mode": "019d5c6c-ca34-771b-aaed-f5d00accfd12"
    }
  }
}

vars:post-response {
  threadId: res.body.id
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.id: isNumber
}

tests {
  test("thread created with id", function () {
    const data = res.getBody();
    expect(data).to.have.property('id');
    expect(data.id).to.be.a('number');
  });
}

docs {
  create a thread for the dewey dialogue.
  requires deweyModeId — get from manifest or mode entity lookup.
}
