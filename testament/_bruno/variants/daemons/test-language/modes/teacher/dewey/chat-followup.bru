meta {
  name: chat followup
  type: http
  seq: 4
}

post {
  url: {{TEACHER_DEWEY}}/dialogue/chat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "thread": "019d5c7c-5f87-72d8-aec1-9c0985fd22be",
    "message": "E como se diz 'kitchen'?"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("response is SSE stream", function () {
    expect(res.getHeader('content-type')).to.equal('text/event-stream');
  });
  
  test("stream contains assistant response", function () {
    const text = res.getBody();
    expect(text).to.contain('turn.open');
    expect(text).to.contain('turn.close');
  });
}

docs {
  second message on same thread — tests multi-turn history.
  dewey should have context from the first message.
}
