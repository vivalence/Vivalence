meta {
  name: chat
  type: http
  seq: 1
}

post {
  url: {{TEACHER_DEWEY}}/harness/dialogue/stream
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "thread": "{{DEWEY_THREAD_ID}}",
    "parts": [{ "type": "text", "text": "Oi Dewey! Como se diz 'house' em português?" }]
  }
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains text/event-stream
}

tests {
  test("SSE stream contains full turn lifecycle", function () {
    const body = res.getBody();
    expect(body).to.contain('"event":"turn.open"');
    expect(body).to.contain('"event":"part.delta"');
    expect(body).to.contain('"event":"turn.close"');
  });

  test("response contains Portuguese content", function () {
    const body = res.getBody();
    expect(body).to.contain('casa');
  });

  test("turn.close carries meta with stop reason", function () {
    const frames = body.split('\n\n').filter(Boolean).map(f => {
      try { return JSON.parse(f.replace(/^data: /, '')); } catch { return null; }
    }).filter(Boolean);
    const close = frames.find(f => f.event === 'turn.close');
    expect(close).to.not.be.undefined;
    expect(close.meta.stop).to.equal('end_turn');
  });
}
