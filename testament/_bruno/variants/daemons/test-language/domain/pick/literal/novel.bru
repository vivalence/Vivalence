meta {
  name: novel
  type: http
  seq: 2
}

post {
  url: {{DAEMON}}/pick/literal/novel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "take": 1,
    "seek": {
      "symbols": [
        "sentence",
        "proficiency.survival"
      ]
    }
  }
}

docs {
  due by play
}
