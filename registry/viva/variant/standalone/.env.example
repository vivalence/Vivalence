# copy to .env and fill in. this is the standalone variant's env template.
# VIVA_*_MOUNT are absolute, per-machine — replace <repo> with your absolute repo path.
VIVA_SYSTEM_MODE="DEVELOPMENT"
VIVA_SYSTEM_ROLE="SUDO"

VIVA_REPOSITORY_MOUNT="<repo>"
VIVA_LEDGER_MOUNT="<repo>/testament/ledger"
VIVA_VARIANT_MOUNT="<repo>/testament/standalone"
VIVA_MOUNTPOINT_MOUNT="<repo>/testament/standalone/mountpoint"

# the flashcard mode is HARNESSED — the coach needs a key. everything else runs without one.
SECRET_VIVA_JWT=""
SECRET_VIVA_ANTHROPIC_API_KEY=""
