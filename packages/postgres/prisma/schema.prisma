generator app-client {
  output          = "../../client/node_modules/.prisma/client"
  provider        = "prisma-client-js"
  clientOutput    = "@prisma/client"
  previewFeatures = ["views"]
}

generator local-client {
  provider        = "prisma-client-js"
  clientOutput    = "@prisma/client"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  // extensions = [pg_graphql, pg_net, pg_stat_statements, pgcrypto, pgjwt, pgsodium, supabase_vault]
  url      = env("DATABASE_URL")
}

model AppUser {
  id          String          @id @unique // same as auth."users".id
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  email       String?
  roles       UserRolesEnum[] @default([USER]) // synced to raw_user_meta_data by pg hook
  strategies  Strategy[]      @relation("AppUserToStrategy")
  Play        Play[]          
  memories    Memory[]          
}

model Strategy {
  id        String    @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  objectStatus ObjectStatusEnum @default(ACTIVE)
  name      String
  data      Json      @default("{}")
  user      AppUser[] @relation("AppUserToStrategy")
  tags      Tag[]     @relation("StrategyToTag")
  games     Game[]    @relation("StrategyToGame")
  units     Unit[]    @relation("StrategyToUnit")
}

model Game {
  id         String       @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt
  objectStatus ObjectStatusEnum @default(ACTIVE)
  name       String
  type       GameTypeEnum
  data       Json         @default("{}")
  plays      Play[]       
  strategies Strategy[]   @relation("StrategyToGame")

  // @@unique([type, ])
}

model Play {
  id        String      @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  history   Json        @default("[]")
  nextPlay  DateTime
  lastPlay  DateTime
  unit      Unit?       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    String?
  tag       Tag?        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String?
  game      Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  user      AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  memory    Memory @relation(fields: [memoryId], references: [id])
  memoryId  String

  @@index([unitId], name: "unitIdIndexOnPlay")
  @@index([tagId], name: "tagIdIndexOnPlay")
  @@index([userId], name: "userIdIndexOnPlay")
  @@index([gameId], name: "gameIdIndexOnPlay")
  @@index([memoryId], name: "memoryIdIndexOnPlay")
  @@unique([unitId, tagId,gameId, userId, memoryId])
}

model Memory {
  id        String           @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  type      MemoryTypeEnum   @default(EBISU_v2)
  status    MemoryStatusEnum @default(UNKNOWN)
  state     Json             @default("{}")
  lastSeen  DateTime?
  history   Json             @default("[]")
  tag       Tag?             @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String?
  unit      Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    String?
  user      AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  plays     Play[]

  @@index([unitId], name: "unitIdIndexOnMemory")
  @@index([userId], name: "userIdIndexOnMemory")
  @@index([tagId], name: "tagIdIndexOnMemory")
  @@unique([unitId, userId, tagId])
}

model Tag {
  id        String        @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  name      String        @unique
  type      TagTypeEnum[] @default([])
  data      Json          @default("{}")
  strategy  Strategy[]    @relation("StrategyToTag")
  units     Unit[]
  memory    Memory[]        // @relation("TagToMemory")
  plays     Play[]

  @@index([name], name: "nameIndexOnTag")
}

model Unit {
  id           String         @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  objectStatus ObjectStatusEnum @default(ACTIVE)
  corpusId     String?
  corpusType   CorpusTypeEnum @default(WORD)
  data         Json
  strategy     Strategy[]     @relation("StrategyToUnit")
  tags         Tag[]
  plays        Play[]
  memory       Memory[]
}

enum QueueStatusEnum {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ObjectStatusEnum {
  ACTIVE
  INACTIVE
  DELETED
}

model Queue {
  id          String         @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt @default(now())
  index       Int             @default(0)
  userId      String
  strategyId  String
  status      QueueStatusEnum @default(PENDING)
  data        Json           @default("{}")
}


enum CorpusTypeEnum {
  WORD
  CONJUGATION
}

enum TagTypeEnum {
  ONTOLOGICAL // subject matter attribute
  STRUCTURAL // organizing of units into sets or categories
  LEARNABLE // higher order feature that one can master
  COMPLETABLE // a set of units where each can be mastered
}

enum MemoryTypeEnum {
  EBISU_v2
  EBISU_v3
}

enum GameTypeEnum {
  FLASHCARDS
  TRANSLATIONS
  CONJUGATIONS
}

enum MemoryStatusEnum {
  UNKNOWN // not yet being learned
  LEARNING // being learned 
  KNOWN // sufficiently learned
  GRADUATED // sufficiently learned and not Showing anymore
}

enum UnitStatusEnum {
  HIDDEN // dont show
  PRIORITIZED // start learning asp
}

enum UserRolesEnum {
  ADMIN
  USER
  GUEST
}
