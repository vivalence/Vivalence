import { Handler, ApertureContext, RouteHandler } from "./types.ts";
// import { RouterContext } from "oak";

export function createRouteHandler(
  handler: Handler,
  preMiddleware: any[] = [],
  postMiddleware: any[] = [],
): RouteHandler {
  return {
    path: "",
    handler: async (body: any, ctx: ApertureContext) => {
      try {
        // Handle pre-middleware
        for (const mw of preMiddleware) {
          await mw(ctx, async () => {});
        }

        // Get body based on request method
        let requestBody = body;
        if (ctx.request.method === "GET") {
          const params = {};
          for (const [key, value] of ctx.request.url.searchParams.entries()) {
            params[key] = value;
          }
          requestBody = params;
        } else if (!body && ctx.request.hasBody) {
          try {
            requestBody = await ctx.request.body({ type: "json" }).value;
          } catch (e) {
            console.error("Body parse error:", e);
          }
        }

        // Store body in context
        ctx.aperture.body = requestBody;

        // Execute handler
        const result = await handler(requestBody, ctx);

        // Store result in context
        ctx.aperture.result = result;

        // Handle post-middleware
        for (const mw of postMiddleware) {
          await mw(ctx, async () => {});
        }

        // Set response body
        ctx.response.body = { data: result };

        return result;
      } catch (error: any) {
        ctx.response.status = error.status || 500;
        ctx.response.body = {
          error: {
            message: error.message || "Internal Server Error",
          },
        };
        throw error;
      }
    },
  };
}
