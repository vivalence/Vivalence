datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  // ABOUT
  id        String          @id @unique // same as auth."users".id
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  roles     UserRolesEnum[] @default([USER]) // synced to raw_user_meta_data by pg hook
  config    Json            @default("{}")

  // RUNTIME
  runtimes   Runtime[]
  strategies Strategy[]

  // USERLAND
  plays    Play[]
  memories Memory[]

  // TRANSIENT
  queue Queue[]
  HEAD  HEAD[]
}

enum UserRolesEnum {
  ADMIN
  USER
  GUEST
}

model Runtime {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  users AppUser[]

  // RUNTIME
  domain   Domain?
  ontology Ontology?
  corpus   Corpus?
  games    Game[]

  // CORPUS
  tactics Tactic[]
  units   Unit[]
  tags    Tag[]

  // USERLAND
  strategies Strategy[]

  // TRANSIENT
  HEAD HEAD[]

  @@unique([slug, version])
}

model Domain {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique

  @@unique([slug, version, runtimeId])
}

model Ontology {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique

  @@unique([slug, version, runtimeId])
}

model Corpus {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique

  @@unique([slug, version, runtimeId])
}

model Game {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)
  mask      Json     @default("{}")

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String

  // USERLAND
  plays Play[]

  @@unique([slug, version, runtimeId])
}

model Tactic {
  // ABOUT
  id          String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  slug        String
  name        String
  description String?

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String

  // USERLAND
  plays Play[]

  // TRANSIENT
  queue Queue[]

  // DATA
  relations    Json @default("[]") // for grouping units and tags
  masks        Json @default("{}") // for games
  instructions Json @default("{}") // for provisioning instructions

  @@unique([slug, runtimeId])
}

model Tag {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String   @unique
  slug      String

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String

  // CORPUS
  units Unit[]

  // USERLAND
  memory Memory[]
  plays  Play[]

  // DATA
  traits TagTraitsEnum[] @default([])
  data   Json            @default("{}")

  @@unique([slug, runtimeId])
  @@index([name], name: "nameIndexOnTag")
}

enum TagTraitsEnum {
  ONTOLOGICAL // subject matter attribute
  STRUCTURAL // organizing of units into sets or categories
  LEARNABLE // higher order feature that one can master
  COMPLETABLE // a set of units where each can be mastered
  DEPENDENCY
}

model Unit {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  slug      String

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String

  // CORPUS
  tags Tag[]

  // USERLAND
  plays  Play[]
  memory Memory[]

  // DATA
  annotation Json @default("{}")
  data       Json @default("{}")

  @@unique([slug, runtimeId])
}

model Strategy {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  slug      String   @default("")
  name      String

  // APP
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String

  // TRANSIENT
  queue Queue[]

  // DATA
  session Json @default("{}")
}

model Play {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // RUNTIME
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String

  // CORPUS
  tactic   Tactic  @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  tacticId String
  unit     Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId   String?
  tag      Tag?    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String?

  // USERLAND
  memory   Memory @relation(fields: [memoryId], references: [id])
  memoryId String

  // DATA
  history  Json     @default("[]")
  nextPlay DateTime
  lastPlay DateTime

  @@unique([userId, unitId, tagId, gameId, tacticId])
  @@index([userId], name: "userIdIndexOnPlay")
  @@index([gameId], name: "gameIdIndexOnPlay")
  @@index([tacticId], name: "tacticIdIndexOnPlay")
  @@index([unitId], name: "unitIdIndexOnPlay")
  @@index([tagId], name: "tagIdIndexOnPlay")
  @@index([memoryId], name: "memoryIdIndexOnPlay")
}

model Memory {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // CORPUS
  tag    Tag?    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId String?

  // USERLAND
  plays Play[]

  // DATA
  type     MemoryTypeEnum   @default(EBISU_v2)
  status   MemoryStatusEnum @default(UNKNOWN)
  state    Json             @default("{}")
  lastSeen DateTime         @default(now())
  history  Json             @default("[]")

  @@unique([unitId, userId, tagId])
  @@index([unitId], name: "unitIdIndexOnMemory")
  @@index([userId], name: "userIdIndexOnMemory")
  @@index([tagId], name: "tagIdIndexOnMemory")
}

enum MemoryStatusEnum {
  UNKNOWN // not yet being learned
  LEARNING // being learned 
  KNOWN // sufficiently learned
  GRADUATED // sufficiently learned and not Showing anymore
}

enum MemoryTypeEnum {
  EBISU_v2
  EBISU_v3
}

model Queue {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  user   AppUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  // CORPUS
  tactic   Tactic @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  tacticId String

  // USERLAND
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyId String

  // DATA
  index  Int             @default(0)
  status QueueStatusEnum @default(PENDING)
  data   Json            @default("{}")
}

enum QueueStatusEnum {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model HEAD {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  data      Json     @default("{}")

  // APP
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique
}
