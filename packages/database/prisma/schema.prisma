datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  // ABOUT
  id        String          @id @unique // same as auth."users".id
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  roles     UserRolesEnum[] @default([USER]) // synced to raw_user_meta_data by pg hook

  // RUNTIME
  runtimes   Runtime[]
  strategies Strategy[]

  // USERLAND
  plays    Play[]
  memories Memory[]

  // TRANSIENT
  queue Queue[]
}

enum UserRolesEnum {
  ADMIN
  USER
  GUEST
}

model Domain {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime Runtime?
}

model Runtime {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String? //@unique
  name      String?
  installed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  users AppUser[]

  // RUNTIME
  domain     Domain?   @relation(fields: [domainId], references: [id])
  domainId   String?   @unique
  ontology   Ontology? @relation(fields: [ontologyId], references: [id])
  ontologyId String?   @unique
  corpus     Corpus?   @relation(fields: [corpusId], references: [id])
  corpusId   String?   @unique

  strategies Strategy[]
  games      Game[]

  // CORPUS
  units   Unit[]
  tags    Tag[]
  tactics Tactic[]
}

model Ontology {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime Runtime?
}

model Corpus {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime Runtime?
}

model Game {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime? @relation(fields: [runtimeId], references: [id])
  runtimeId String?

  // CORPUS
  tactics Tactic[]

  // USERLAND
  plays Play[]

  // DEPRACATED
  data Json?
}

model Tactic {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String

  // RUNTIME
  runtime   Runtime? @relation(fields: [runtimeId], references: [id])
  runtimeId String? // required
  games     Game[] // input for tactic.relations

  // CORPUS 
  tags  Tag[] // input for tactic.relations
  units Unit[] // input for tactic.relations

  // USERLAND
  plays Play[]

  // TRANSIENT
  queue Queue[]

  // DATA
  relations    Json @default("[]") // for grouping units and tags
  masks        Json @default("{}") // for games
  instructions Json @default("{}") // for provisioning instructions
}

model Tag {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String   @unique

  // RUNTIME
  runtime   Runtime? @relation(fields: [runtimeId], references: [id])
  runtimeId String? // required

  // CORPUS
  units   Unit[]
  tactics Tactic[]

  // USERLAND
  strategy   Strategy? @relation(fields: [strategyId], references: [id])
  strategyId String? // for strategy specific or user defined tags
  memory     Memory[]
  plays      Play[]

  // DATA
  traits TagTraitsEnum[] @default([])
  data   Json            @default("{}")

  type TagTypeEnum[] @default([])

  @@index([name], name: "nameIndexOnTag")
}

enum TagTypeEnum {
  ONTOLOGICAL // subject matter attribute
  STRUCTURAL // organizing of units into sets or categories
  LEARNABLE // higher order feature that one can master
  COMPLETABLE // a set of units where each can be mastered
}

enum TagTraitsEnum {
  ONTOLOGICAL // subject matter attribute
  STRUCTURAL // organizing of units into sets or categories
  LEARNABLE // higher order feature that one can master
  COMPLETABLE // a set of units where each can be mastered
  DEPENDENCY
}

model Unit {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // RUNTIME
  runtime   Runtime? @relation(fields: [runtimeId], references: [id])
  runtimeId String? // required

  // CORPUS
  tags    Tag[]
  tactics Tactic[]

  // USERLAND
  strategy   Strategy? @relation(fields: [strategyId], references: [id])
  strategyId String? // for strategy specific or user defined units
  plays      Play[]
  memory     Memory[]

  // DATA
  annotation Json @default("{}")
  data       Json @default("{}")
}

model Strategy {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // APP
  user   AppUser? @relation(fields: [userId], references: [id])
  userId String?

  // RUNTIME
  runtime   Runtime? @relation(fields: [runtimeId], references: [id])
  runtimeId String?

  // CORPUS
  tags  Tag[] // for special or user defined tags
  units Unit[] // for special or user defined units

  // DATA
  session Json @default("{}")

  // DEPRACATED
  relations Json?
  provision Json?
}

model Play {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  user   AppUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  // RUNTIME
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String

  // CORPUS
  tactic   Tactic? @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  tacticId String?
  unit     Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId   String?
  tag      Tag?    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String?

  // USERLAND
  memory   Memory? @relation(fields: [memoryId], references: [id])
  memoryId String?

  // DATA
  history  Json     @default("[]")
  nextPlay DateTime
  lastPlay DateTime

  @@unique([userId, unitId, tagId, tacticId, gameId]) // gameId temporary
  @@index([userId], name: "userIdIndexOnPlay")
  @@index([gameId], name: "gameIdIndexOnPlay")
  @@index([tacticId], name: "tacticIdIndexOnPlay")
  @@index([unitId], name: "unitIdIndexOnPlay")
  @@index([tagId], name: "tagIdIndexOnPlay")
  @@index([memoryId], name: "memoryIdIndexOnPlay")
}

model Memory {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  user   AppUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  // CORPUS
  tag    Tag?    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId String?

  // USERLAND
  plays Play[]

  // DATA
  type     MemoryTypeEnum   @default(EBISU_v2)
  status   MemoryStatusEnum @default(UNKNOWN)
  state    Json             @default("{}")
  lastSeen DateTime         @default(now())
  history  Json             @default("[]")

  @@unique([unitId, userId, tagId])
  @@index([unitId], name: "unitIdIndexOnMemory")
  @@index([userId], name: "userIdIndexOnMemory")
  @@index([tagId], name: "tagIdIndexOnMemory")
}

enum MemoryStatusEnum {
  UNKNOWN // not yet being learned
  LEARNING // being learned 
  KNOWN // sufficiently learned
  GRADUATED // sufficiently learned and not Showing anymore
}

enum MemoryTypeEnum {
  EBISU_v2
  EBISU_v3
}

model Queue {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  user   AppUser? @relation(fields: [userId], references: [id])
  userId String?

  // CORPUS
  tactic   Tactic? @relation(fields: [tacticId], references: [id])
  tacticId String?

  // DATA
  index  Int             @default(0)
  status QueueStatusEnum @default(PENDING)
  data   Json            @default("{}")
}

enum QueueStatusEnum {
  PENDING
  PROCESSING
  DONE
  FAILED
}
