model Runtime {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  slug      String  
  description String?
  name      String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // APP
  users AppUser[] 

  // RUNTIME
  domain     Domain?
  ontology   Ontology?
  corpora    Corpus[]
  games      Game[]

  // CORPUS
  tactics Tactic[]
  units   Unit[]
  tags    Tag[]

  // USERLAND
  strategies Strategy[]
  plays      Play[]
  memories   Memory[]


  // TRANSIENT
  HEAD       HEAD[]

  @@unique([slug])
}

model Domain {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  description String?
  name      String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String @unique 

  @@unique([slug, runtimeId])
}

model Ontology {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  description String?
  name      String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique

  @@unique([slug, runtimeId])
}

model Corpus {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String?
  description String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String   

  // CORPUS
  // optional, in case of ownership
  tactics Tactic[]
  units   Unit[]
  tags    Tag[]

  @@unique([slug, runtimeId])
}

model Game {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String?
  description String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)
  mask      Json     @default("{}") 

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  

  // USERLAND
  plays     Play[]

  @@unique([slug, runtimeId])
}

