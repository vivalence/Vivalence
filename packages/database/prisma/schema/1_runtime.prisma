model Runtime {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String  
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  users AppUser[] 

  // RUNTIME
  domain     Domain?
  ontology   Ontology?
  corpus     Corpus?
  games      Game[]

  // CORPUS
  tactics Tactic[]
  units   Unit[]
  tags    Tag[]

  // USERLAND
  strategies Strategy[]

  // TRANSIENT
  HEAD       HEAD[]

  @@unique([slug])
}

model Domain {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique 

  @@unique([slug, runtimeId])
}


model Ontology {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique 

  @@unique([slug, runtimeId])
}

model Corpus {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique 

  @@unique([slug, runtimeId])
}

model Game {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)
  mask      Json     @default("{}") 

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  

  // USERLAND
  plays     Play[]

  @@unique([slug, runtimeId])
}

