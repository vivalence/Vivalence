model Strategy {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  slug      String   @default("")
  name      String
  version   String   @default("0.0.0")
  installed Boolean  @default(false)
  description String?

  // APP
  user AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String

  // TRANSIENT
  queue        Queue[]

  // DATA
  session Json @default("{}")
}

model Play {
  // ABOUT
  id        String      @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  // APP
  user      AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String 

  // RUNTIME
  runtime   Runtime      @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  

  game      Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String

  // CORPUS
  tactic    Tactic?      @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  tacticId  String?

  unit      Unit?        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    String? 
  tag       Tag?         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String?

  // USERLAND
  memory    Memory        @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  memoryId  String 

  // DATA
  history   Json          @default("[]")
  signal    Json          @default("{}") 

  nextIn    Int             @default(0)
  nextAt    DateTime        @default(now())
  lastAt    DateTime        @default(now())


  @@index([userId], name: "userIdIndexOnPlay")
  @@index([gameId], name: "gameIdIndexOnPlay")
  @@index([tacticId], name: "tacticIdIndexOnPlay")
  @@index([unitId], name: "unitIdIndexOnPlay")
  @@index([tagId], name: "tagIdIndexOnPlay")
  @@index([memoryId], name: "memoryIdIndexOnPlay")
  @@unique([userId, unitId, tagId, gameId, tacticId])
}

model Memory {
  // ABOUT
  id        String           @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  // APP
  user      AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String 

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String 

  // CORPUS
  tag       Tag?             @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String?
  unit      Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    String?

  // USERLAND
  plays     Play[]

  // DATA
  type      MemoryTypeEnum   @default(BAYESIAN)
  falvor    MemoryFlavorEnum @default(INDIVIDUAL)
  status    MemoryStatusEnum @default(UNKNOWN)
  state     Json             @default("{}")
  history   Json             @default("[]")
  signal    Json             @default("{}") 

  nextIn    Int             @default(0)
  nextAt    DateTime        @default(now())
  lastAt    DateTime        @default(now())

  @@index([unitId], name: "unitIdIndexOnMemory")
  @@index([userId], name: "userIdIndexOnMemory")
  @@index([tagId], name: "tagIdIndexOnMemory")
  @@unique([unitId, userId, tagId])
}

enum MemoryTypeEnum {
  BOOLEAN
  BAYESIAN
}

enum MemoryFlavorEnum {
  RELATIONAL // Memory strenght is a function of its relations. only on tags.
  INDIVIDUAL // default for units. 
}

enum MemoryStatusEnum {
  UNTOUCHED // should not exist in database
  UNKNOWN // not yet being learned but touched
  LEARNING // being actively learned 
  KNOWN // sufficiently learned
  GRADUATED // sufficiently learned and not Showing anymore
}


