model Tactic {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  slug      String
  name      String?
  description String?
  version   String   @default("0.0.0")
  installed Boolean  @default(false)

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String 

  corpus    Corpus?   @relation(fields: [corpusId], references: [id], onDelete: Cascade) 
  corpusId  String?

  // USERLAND
  plays      Play[]       

  // TRANSIENT
  queue      Queue[]

  // DATA
  relations  Json @default("{}") // for grouping units, tags and games
  masks      Json @default("{}") // for customizing games

  @@unique([slug, runtimeId] )
}

model Tag {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String  
  slug      String   
  description String?

  // RUNTIME
  runtime   Runtime  @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String

  corpus    Corpus?   @relation(fields: [corpusId], references: [id], onDelete: Cascade) 
  corpusId  String?

  // CORPUS
  units   Unit[]

  // USERLAND
  memory       Memory[]        
  plays        Play[]

  // DATA
  traits   TagTraitsEnum[] @default([])
  data     Json          @default("{}")

  @@index([name], name: "nameIndexOnTag")
  @@unique([slug, runtimeId])
}

enum TagTraitsEnum {
  ONTOLOGICAL // subject matter attribute
  STRUCTURAL // organizing of units into sets or categories
  DEPENDENCY // defines preconditions, conditions and a way to master the condition
  LEARNABLE // higher order feature that can be mastered
  COMPLETABLE // contains a set of units where each can be mastered
}

model Unit {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  slug      String  

  // RUNTIME
  runtime   Runtime  @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String 

  corpus    Corpus?   @relation(fields: [corpusId], references: [id], onDelete: Cascade) 
  corpusId  String?

  // CORPUS
  tags    Tag[]

  // USERLAND
  plays        Play[]
  memory       Memory[]

  // DATA
  annotation   Json     @default("{}")
  data         Json     @default("{}")

  @@unique([slug, runtimeId])
}


