model Tag {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String   @unique

  // APP
  // user     User? @relation(fields: [userId], references: [id])
  // userId   String? // for user defined units

  // RUNTIME
  runtime   Runtime? @relation(fields: [runtimeId], references: [id])
  runtimeId String? // required

  // CORPUS
  units   Unit[]
  tactics Tactic[]

  // USERLAND
  // strategy     Strategy? @relation(fields: [strategyId], references: [id])
  // strategyId   String? // for strategy specific or user defined tags
  memory       Memory[]        
  plays        Play[]

  // DATA
  traits   TagTraitsEnum[] @default([])
  data     Json          @default("{}")

  @@index([name], name: "nameIndexOnTag")
}

enum TagTraitsEnum {
  ONTOLOGICAL // subject matter attribute
  STRUCTURAL // organizing of units into sets or categories
  LEARNABLE // higher order feature that one can master
  COMPLETABLE // a set of units where each can be mastered
  DEPENDENCY
}

model Unit {
  // ABOUT
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  // user     User? @relation(fields: [userId], references: [id])
  // userId   String? // for user defined units

  // RUNTIME
  runtime   Runtime? @relation(fields: [runtimeId], references: [id])
  runtimeId String? // required

  // CORPUS
  tags    Tag[]
  tactics Tactic[]

  // USERLAND
  // strategy     Strategy? @relation(fields: [strategyId], references: [id])
  // strategyId   String? // for strategy specific or user defined units
  plays        Play[]
  memory       Memory[]

  // DATA
  annotation   Json     @default("{}")
  data         Json     @default("{}")
}


