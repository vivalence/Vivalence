model User {
  // ABOUT
  id        String          @id  
  roles     Json            @default("\"[]\"")
  config    Json            @default("\"{}\"")

  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  // RUNTIME
  runtimes   Runtime[]   
  strategies Strategy[] 

  // USERLAND
  plays       Play[]           
  memories    Memory[]          

  // TRANSIENT
  queue       Queue[]
  HEAD        HEAD[]
}

