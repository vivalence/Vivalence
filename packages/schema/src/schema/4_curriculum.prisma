model Unit {
  // ABOUT
  id        String   @id 
  slug      String  

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // RUNTIME
  runtime   Runtime  @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String 

  corpus    Corpus?  @relation(fields: [corpusId], references: [id], onDelete: SetNull) 
  corpusId  String?

  // CORPUS
  tags      Tag[]

  // USERLAND
  plays        Play[]
  memory       Memory[]

  // DATA
  annotation   Json     
  data         Json    
  index        Int?      

  @@unique([slug, runtimeId])
}

model Tag {
  // ABOUT
  id          String   @id 
  slug        String   
  name        String  
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // RUNTIME
  runtime     Runtime  @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId   String

  corpus      Corpus?  @relation(fields: [corpusId], references: [id], onDelete: SetNull) 
  corpusId    String?

  // CORPUS
  units       Unit[]

  // USERLAND
  memory      Memory[]        
  plays       Play[]

  // DATA
  traits      Json  
  data        Json        

  @@index([name], name: "nameIndexOnTag")
  @@unique([slug, runtimeId])
}

enum TagTraitsEnum {
  ONTOLOGICAL // subject matter attribute
  STRUCTURAL // organizing of units into sets or categories
  LEARNABLE // higher order feature that can be mastered
  COMPLETABLE // contains a set of units where each can be mastered
}

model Dependency {
  // ABOUT
  id             String   @id 
  slug           String   
  name           String
  description    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  // APP
  // Not yet used. under consideration. irrelevant for singleplayer.
  // user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // userId      String

  // RUNTIME
  runtime        Runtime  @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId      String

  corpus         Corpus?  @relation(fields: [corpusId], references: [id], onDelete: SetNull) 
  corpusId       String?

  // CORPUS
  preconditions  Condition[] @relation("Precondition")
  conditions     Condition[] @relation("Condition")
  itinerary      Json  @default("\"{}\"") 

  // TRANSIENT
  queue          Queue[]

  // DATA
  available      Boolean       @default(false) // all preconditions met
  satisfied      Boolean       @default(false) // all conditions met

  @@unique([slug, runtimeId])
}

model Condition {
  // ABOUT
  id           String   @id 
  name         String?
  description  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  // APP
  // Not yet used. under consideration. irrelevant for singleplayer.
  // user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // userId      String

  // RUNTIME
  runtime      Runtime  @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId    String

  corpus       Corpus?  @relation(fields: [corpusId], references: [id], onDelete: SetNull) 
  corpusId     String?

  // CORPUS
  conditionFor    Dependency[] @relation("Condition")
  preconditionFor Dependency[] @relation("Precondition")

  scope         Json   @default("\"{}\"") 

  // DATA
  assertion     Json    @default("\"{}\"") 
  met           Boolean  @default(false)
}

