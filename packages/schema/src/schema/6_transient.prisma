model Queue {
  id          String         @id 
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt @default(now())

  // APP
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  // RUNTIME
  runtime     Runtime      @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId   String   

  // CORPUS
  game         Game?       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId       String?
  tactic       Tactic?     @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  tacticId     String?
  dependency   Dependency? @relation(fields: [dependencyId], references: [id], onDelete: Cascade)
  dependencyId String?

  // DATA
  index       Int             @default(0)
  status      QueueStatusEnum @default(PENDING)
  data        Json            @default("\"{}\"")
}

enum QueueStatusEnum {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model HEAD {
  id          String         @id 
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt @default(now())

  // APP
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  // RUNTIME
  runtime     Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId   String  @unique 

  // 
  data        Json           @default("\"{}\"")
}
