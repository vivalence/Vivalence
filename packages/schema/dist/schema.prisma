datasource database {
  provider = "sqlite"
  url      = env("PRISMA_DATABASE_SOURCE_TOKEN")
}

model User {
  // ABOUT
  id     String @id
  roles  Json   @default("\"[]\"")
  config Json   @default("\"{}\"")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // RUNTIME
  runtimes   Runtime[]
  strategies Strategy[]

  // USERLAND
  plays    Play[]
  memories Memory[]

  // TRANSIENT
  queue Queue[]
  HEAD  HEAD[]
}

// enum UserRolesEnum {ADMIN USER GUEST}

// roles     UserRolesEnum[] @default([USER]) // synced to raw_user_meta_data by pg hook

model Runtime {
  // ABOUT
  id          String  @id
  slug        String
  version     String  @default("0.0.0")
  installed   Boolean @default(false)
  name        String?
  description String?
  icon        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  users User[]

  // RUNTIME
  domain   Domain?
  ontology Ontology?
  corpora  Corpus[]
  games    Game[]

  // CORPUS
  tactics      Tactic[]
  units        Unit[]
  tags         Tag[]
  dependencies Dependency[]
  conditions   Condition[]

  // USERLAND
  strategies Strategy[]
  plays      Play[]
  memories   Memory[]

  // TRANSIENT
  HEAD  HEAD[]
  queue Queue[]

  @@unique([slug])
}

model Domain {
  // ABOUT
  id          String  @id
  slug        String
  version     String  @default("0.0.0")
  installed   Boolean @default(false)
  name        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique

  @@unique([slug, runtimeId])
}

model Ontology {
  // ABOUT
  id          String  @id
  slug        String
  version     String  @default("0.0.0")
  installed   Boolean @default(false)
  name        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String  @unique

  @@unique([slug, runtimeId])
}

model Strategy {
  // ABOUT
  id          String  @id
  slug        String  @default("")
  version     String  @default("0.0.0")
  installed   Boolean @default(false)
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // APP
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // RUNTIME
  runtime   Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  runtimeId String

  // DATA
  data Json @default("\"{}\"")

  @@unique([slug, runtimeId])
}

