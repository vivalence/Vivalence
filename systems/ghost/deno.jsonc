{
  "name": "@vivalence/ghost",
  "version": "0.0.1",
  "exports": {
    ".": "./typology.js",
    "./host": "./host.js",
    "./run": "./run.js",
    "./scenarios": "./tests/scenarios/index.js",
  },
  "publish": {
    "exclude": ["tests/"],
  },
  "tasks": {
    "run": "deno run -A run.js",
    "watch": "deno run -A --watch run.js",
    "bundle": "deno run -A surfaces/chrome/bundle.js",
    "test": "deno test -A --no-check --watch tests/**/*.test.js",
  },
}
