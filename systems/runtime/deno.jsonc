{
  "name": "@vivalence/runtime",
  "description": "a deamon is something intelligent and agentic that doesnt have a soul.",
  "version": "0.0.1",
  "exports": {
    ".": "./mod.js",
    "./run": "./run.js",
    "./daemon": "./daemon/index.js",
    "./process": "./process/index.js",
  },
  "tasks": {
    "start": "deno run -A run.js",
    "watch": "deno run -A --watch run.js",
    "test": "deno test -A --no-check --watch tests/**/*.test.js",

    "test/runtime": "deno test -A --no-check --watch tests/runtime/*.test.js",
    "test/runtime/lifecycle": "deno test -A --no-check --watch tests/runtime/lifecycle.test.js",
    "test/runtime/aperture": "deno test -A --no-check --watch tests/runtime/aperture.test.js",

    "test/daemon": "deno test -A --no-check --watch tests/daemon/*.test.js",
    "test/daemon/lifecycle": "deno test -A --no-check --watch tests/daemon/lifecycle.test.js",
    "test/daemon/aperture": "deno test -A --no-check --watch tests/daemon/aperture.test.js",
    "test/daemon/modes": "deno test -A --no-check --watch tests/daemon/modes.test.js",

    "test/process": "deno test -A --no-check --watch tests/process/*.test.js",
  },
}
