{
  "name": "@vivalence/runtime",
  "description": "a deamon is something intelligent and agentic that doesnt have a soul.",
  "version": "0.0.1",
  "exports": {
    ".": "./mod.js",
    "./run": "./run.js",
    "./daemon": "./daemon/index.js",
    "./process": "./process/index.js",
    "./tests/scenario": "./tests/scenario/daemon.js",
  },
  "tasks": {
    "start": "deno run -A run.js",
    "watch": "deno run -A --watch run.js",
    "test": "deno test -A --no-check --watch tests/scenario/*.test.js",

    "test/scenario": "deno test -A --no-check --watch tests/scenario/*.test.js",
    "test/scenario/routes": "deno test -A --no-check --watch tests/scenario/routes.test.js",
    "test/scenario/runtime": "deno test -A --no-check --watch tests/scenario/runtime.test.js",
  },
}
