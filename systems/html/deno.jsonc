  "tasks": {
    "watch": "deno run -A npm:vite dev",
    "start": "deno run -A npm:vite dev",
    "preview": "deno run -A npm:vite preview",
    "build": "docker build -f ./Dockerfile -t viva/html:latest ../..",
  },
}

