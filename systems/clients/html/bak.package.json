{
  "name": "@vivalence/html",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "tailwind-config-viewer": "npx tailwind-config-viewer -o",
    "css:bsp": "npx postcss --config postcss.config.js src/style/bsp/bsp.css -o test-output.css"
  },
  "dependencies": {
    "@sveltejs/adapter-auto": "3.3",
    "@sveltejs/kit": "2.43",
    "@sveltejs/vite-plugin-svelte": "6.2",
    "svelte": "5.39",
    "@sinclair/typebox": "^0.34.33",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@tailwindcss/typography": "0.5.15",
    "autoprefixer": "10.4.20",
    "bits-ui": "^1.4",
    "carbon-icons-svelte": "^13.3",
    "clsx": "^2.0.0",
    "crypto-js": "^4.2.0",
    "dockview-core": "^4.2",
    "fs-extra": "^11.2.0",
    "mitt": "3.0.1",
    "postcss": "8.4.49",
    "nanostores": "^1.0",
    "tailwind-merge": "^2.0.0",
    "tailwind-variants": "^0.1.18",
    "tailwindcss": "3.4.14",
    "three": "0.169.0",
    "tinykeys": "3.0.0"
  },
  "devDependencies": {
    "vite": "6.3",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.35.0",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^3.1.0",
    "svelte-check": "^3.6.0",
    "typescript": "^5.3.0"
  }
}
