// Helper function to generate constraint lists for different tactics
export function generateConstraints({
	pattern,
	pronoun,
	verb,
	tense,
	mood,
	complexity,
	topicContext,
	additionalRequirements,
}) {
	const constraints = [];

	// Add grammatical component constraints
	if (pronoun) {
		constraints.push(`PRONOUN: ${pronoun.name} (${pronoun.slug})`);
	}

	if (verb) {
		constraints.push(`VERB: ${verb.name} (${verb.slug})`);
	}

	if (tense) {
		constraints.push(`TENSE: ${tense.name}`);
	}

	if (mood) {
		constraints.push(`MOOD: ${mood.name}`);
	}

	// Add pattern constraint
	if (pattern && SentencePatterns[pattern]) {
		constraints.push(SentencePatterns[pattern].activation);
	}

	// Add complexity constraint
	if (complexity) {
		constraints.push(`COMPLEXITY: ${complexity} level vocabulary and grammar`);
	}

	// Add topic/context constraint
	if (topicContext) {
		constraints.push(`CONTEXT: ${topicContext}`);
	}

	// Add any additional specific requirements
	if (additionalRequirements && additionalRequirements.length) {
		additionalRequirements.forEach((req) => constraints.push(req));
	}

	return constraints;
}
