{
  "nodeModulesDir": "auto",
  "importMap": "./import_map.json",
  "workspace": [
    "./config",
    "./packages/types",
    "./packages/shared",
    "./packages/entities",
    "./packages/registry",
    "./packages/repository",
    "./packages/clients/cli",
    "./packages/clients/web",
    "./packages/interfaces/cli",
    "./packages/interfaces/display",
  ],
  "tasks": {
    "deno:install": "deno install --allow-scripts=npm:sqlite3",
    "viva:install": "deno run deno:install && deno install --global -f -A -n viva ./packages/clients/cli/cli-entry.js $PWD",

    "viva": "VIVA_ROLE=sudo deno run -A ./packages/clients/cli/mod.js",
    "viva:watch": "VIVA_ROLE=sudo deno run --watch -A ./packages/clients/cli/mod.js",

    "daemon:watch": "OTEL_DENO=true VIVA_ROLE=daemon deno run --watch --unstable-otel -A  ./packages/daemon/mod.ts",
    "web:watch": "VIVA_ROLE=client deno run -A packages/clients/web/mod.js",

    // "schema:compile": "VIVA_ROLE=sudo deno run -A packages/schema/compile.js",
    // "schema:deploy": "deno task schema:compile && VIVA_ROLE=sudo deno run -A packages/schema/deploy.js",
    // "schema:generate": "VIVA_ROLE=sudo deno run -A packages/schema/src/generate.js",
  },
}
