{
  "nodeModulesDir": "auto",
  "importMap": "./import_map.json",
  "exclude": ["./tilde/"],
  "workspace": [
    "./systems/gaia",
    "./systems/hut",
    "./systems/ghost",
    "./subsystems/typology",
    "./subsystems/vector",
    "./subsystems/paladin",
    "./subsystems/shared",
    "./subsystems/surfaces/dapper",
    "./subsystems/surfaces/drapes",
    "./subsystems/surfaces/sheets",
  ],
  "tasks": {
    "deno:install": "deno install --allow-scripts=npm:sqlite3,npm:svelte-preprocess",
    "viva:install": "deno install --global -f -A -n viva ./systems/ghost/mod.js",
    "install": "deno run deno:install && deno run viva:install && deno run ikiro",
    // "test:registry": "deno run --watch -A ./systems/ghost/mod.js",
    "test:paladin": "deno run --watch -A ./subsystems/paladin/tests/*.test.js",
    "test:typology": "deno run --watch -A ./subsystems/typology/tests/**/*.test.js",
    // "test:subsystems": "deno run --watch -A ./systems/ghost/mod.js",
    // "test:gaia": "deno run --watch -A  ./systems/gaia/mod.ts",
    // "test:ghost": "deno run --watch -A ./systems/ghost/mod.js",
    "gaia:watch": "deno run --watch -A  ./systems/gaia/mod.ts",
    "ghost:watch": "deno run --watch -A ./systems/ghost/mod.js",
    "hut:watch": "deno run --watch -A ./systems/hut/mod.js",
    "gaia": "deno run -A  ./systems/gaia/mod.js",
    "ghost": "deno run -A ./systems/ghost/mod.js",
    "hut": "deno run -A ./systems/hut/mod.js",
    "tree": "tree -I 'node_modules|static' --prune",
  },
}
