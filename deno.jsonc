{
  "nodeModulesDir": "auto",
  "importMap": "./import_map.json",
  "exclude": ["./tests", "./docs", "./registry"],
  "workspace": [
    "./systems/runtime",
    "./systems/html",
    "./systems/shell",
    "./subsystems/typology",
    "./subsystems/vector",
    "./subsystems/paladin",
    "./subsystems/shared",
    "./subsystems/surfaces/dapper",
    "./subsystems/surfaces/drapes",
    "./subsystems/surfaces/sheets",
  ],
  "tasks": {
    // --cwd ./packages/client
    // "build:add": "deno task -f @scope/add build"
    "tree": "tree -I 'node_modules|static' --prune",
    "deno/install": "deno install --allow-scripts=npm:sqlite3,npm:svelte-preprocess",
    "viva/install": "deno install --global -f -A -n viva ./systems/shell/mod.js",
    "install": "deno run deno/install && deno run viva/install",
    // "test:registry": "deno run --watch -A ./systems/shell/mod.js",
    "test/paladin": "deno run --watch -A ./subsystems/paladin/tests/*.test.js",
    "test/typology": "deno run --watch -A ./subsystems/typology/tests/**/*.test.js",
    // "test:subsystems": "deno run --watch -A ./systems/shell/mod.js",
    // "test:runtime": "deno run --watch -A  ./systems/runtime/mod.ts",
    // "test:shell": "deno run --watch -A ./systems/shell/mod.js",
    "runtime/watch": "deno run --watch -A  ./systems/runtime/mod.js",
    "runtime/up": "deno run -A  ./systems/runtime/mod.js",
    "shell/watch": "deno run --watch -A ./systems/shell/mod.js",
    "shell/do": "deno run -A ./systems/shell/mod.js",
    "html/watch": "deno task --cwd ./systems/html watch",
    // "html/up": "deno run -A ./systems/html/mod.js",
    "viva/build": "docker build -f ./Dockerfile -t vivalence/viva:alpine .",
    "runtime/build": "docker build -f ./systems/runtime/Dockerfile -t vivalence/runtime:alpine .",
    "html/build": "docker build -f ./systems/html/Dockerfile -t vivalence/html:alpine .",
    "build": "DOCKER_BUILDKIT=1 deno run viva/build && deno run runtime/build && deno run html/build",

    "viva/tag": "docker tag vivalence/viva:alpine registry.vivalence.org/vivalence/viva:alpine",
    "runtime/tag": "docker tag vivalence/runtime:alpine registry.vivalence.org/vivalence/runtime:alpine",
    "html/tag": "docker tag vivalence/html:alpine registry.vivalence.org/vivalence/html:alpine",
    "tag": "deno run viva/tag && deno run runtime/tag && deno run html/tag",

    "viva/push": "docker push registry.vivalence.org/vivalence/viva:alpine",
    "runtime/push": "docker push registry.vivalence.org/vivalence/runtime:alpine",
    "html/push": "docker push registry.vivalence.org/vivalence/html:alpine",
    "push": "deno run viva/push && deno run runtime/push && deno run html/push",

    "publish": "deno run build && deno run tag && deno run push",
  },
}
