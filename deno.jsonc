{
  "importMap": "./import_map.json",
  "workspace": [
    "./config",
    "./packages/shared",
    "./packages/schema",
    "./packages/registry",
    "./packages/interfaces/display",
  ],
  "tasks": {
    "daemon:dev": "DENO_ROLE=daemon deno run -A --watch packages/daemon/mod.js",
    "clients:web:dev": "DENO_ROLE=client deno run -A packages/clients/web/mod.js --dev",

    "schema:compile": "DENO_ROLE=sudo deno run -A packages/schema/compile.js",
    "schema:deploy": "deno task schema:compile && DENO_ROLE=sudo deno run -A packages/schema/deploy.js",
  },
}
