{
  "nodeModulesDir": "auto",
  "importMap": "./import_map.json",
  "workspace": [
    "./systems/daemon",
    "./systems/clients/html",
    "./systems/clients/shell",
    "./subsystems/typology",
    "./subsystems/shared",
    "./subsystems/vector",
    "./subsystems/config",
    "./subsystems/registry",
    "./subsystems/entities",
    "./interfaces/html",
    "./interfaces/shell",
  ],
  "tasks": {
    "deno:install": "deno install --allow-scripts=npm:sqlite3",
    "viva:install": "deno install --global -f -A -n viva ./systems/clients/shell/entry.js $PWD",
    "install": "deno run deno:install && deno run viva:install",
    "daemon:watch": "deno run --watch -A  ./systems/daemon/mod.ts",
    "html:watch": "deno run -A system/clients/html/mod.js",
    "shell:run": "deno run -A ./systems/clients/shell/mod.js",
    "shell:watch": "deno run --watch -A ./systems/clients/shell/mod.js",
    "viva": "deno run -A ./systems/clients/shell/mod.js",
  },
}
