{
  "importMap": "./import_map.json",
  "workspace": [
    "./config",
    "./packages/shared",
    "./packages/schema",
    "./packages/registry",
    "./packages/clients/web",
    "./packages/clients/viva",
    "./packages/interfaces/cli",
    "./packages/interfaces/display",
    "./packages/types"
  ],
  "nodeModulesDirs": "auto",
  "tasks": {
    "viva:install": "deno install --global -f -A -n viva ./packages/clients/viva/cli-entry.js $PWD",
    "viva": "VIVA_ROLE=sudo deno run -A ./packages/clients/viva/mod.js",
    "viva:dev": "VIVA_ROLE=sudo deno run --watch -A ./packages/clients/viva/mod.js",

    "daemon:dev": "VIVA_ROLE=daemon deno run --watch -A  packages/daemon/mod.ts",
    "web:dev": "VIVA_ROLE=client deno run -A packages/clients/web/mod.js",

    "schema:compile": "VIVA_ROLE=sudo deno run -A packages/schema/compile.js",
    "schema:deploy": "deno task schema:compile && VIVA_ROLE=sudo deno run -A packages/schema/deploy.js"
  }
}
