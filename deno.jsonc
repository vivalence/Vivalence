{
  "nodeModulesDir": "auto",
  "importMap": "./import_map.json",
  "exclude": ["./testament", "./docs"],
  "unstable": ["raw-imports"],
  "compilerOptions": {
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
  },
  "workspace": [
    "./systems/runtime",
    "./systems/anima",
    "./systems/ghost",
    // "./systems/test/tbone",
    "./subsystems/typology",
    "./subsystems/paladin",
    "./subsystems/dapper",
    "./subsystems/drapes",
    "./subsystems/sheets",
    "./documentation",
  ],
  "tasks": {
    "tree": "tree -I 'node_modules|static' --prune",
    "gource": "gource --output-custom-log /tmp/vivalence.gource.log . && awk -F'|' '$4 ~ /\\.(svelte|tsx|ts|jsx|js|cjs|mjs|sql|prisma|css|pcss|postcss)$/' /tmp/vivalence.gource.log > /tmp/vivalence.loadbearing.log && awk -F'|' 'BEGIN{OFS=\"|\"} {if ($2 ~ /^(crackedbeefcake|finn|Finn Luca Frotscher|LazerJesus)$/) $2=\"beef\"; print}' /tmp/vivalence.loadbearing.log > /tmp/vivalence.normalized.log && gource /tmp/vivalence.normalized.log -1920x1080 -s 0.0490 --auto-skip-seconds 0.1 --stop-at-end --key --title @vivalence --hide mouse,progress,filenames --file-idle-time 0 --max-files 0 --bloom-multiplier 0.5 --font-size 22 --dir-font-size 12 --dir-name-depth 4 --dir-name-position 1.0 --user-scale 2.5 --colour-images --disable-auto-rotate --elasticity 0.03 --user-friction 1.0 --padding 1.4 --user-filter '^Ivan Matcuka$' --font-file /System/Library/Fonts/SFNSMono.ttf --date-format '%Y.%m.%d [%a]' --output-ppm-stream - --output-framerate 60 | ffmpeg -y -r 60 -f image2pipe -vcodec ppm -i - -vcodec libx264 -preset medium -pix_fmt yuv420p -crf 23 -threads 0 -bf 0 gource.mp4",

    // "viva/install": "deno install --global --config ./deno.jsonc -f -A -n viva ./systems/shell/mod.js",
    "dependencies": "deno install --allow-scripts=npm:sqlite3,npm:better-sqlite3,npm:argon2,npm:svelte-preprocess",
    "install": "deno task dependencies && deno task ghost/install",

    "paladin/test": "deno task --cwd ./subsystems/paladin test",
    "typology/test": "deno task --cwd ./subsystems/typology test",
    "typology/test/snapshots": "deno task --cwd ./subsystems/typology test/snapshots",
    "runtime/test": "deno task --cwd ./systems/runtime test",
    "runtime/test/snapshots": "deno task --cwd ./systems/runtime test/snapshots",
    "anima/test": "deno task --cwd ./systems/anima test",
    "ghost/test": "deno task --cwd ./systems/ghost test",

    "runtime/run": "deno task --cwd ./systems/runtime run",
    "runtime/watch": "deno task --cwd ./systems/runtime watch",

    "ghost/run": "deno run -A ./systems/ghost/mod.js",
    "ghost/watch": "deno run -A --watch ./systems/ghost/mod.js",
    // "ghost/run": "deno run -A  ./systems/ghost/mod.js",
    "ghost/watch": "deno run -A   ./systems/ghost/mod.js",
    "ghost/install": "sh systems/ghost/install.sh \"$(pwd)\"",

    "anima/run": "deno task --cwd ./systems/anima run",
    "anima/watch": "deno task --cwd ./systems/anima watch",
    "anima/bundle": "deno task --cwd ./systems/anima bundle",

    "documentation/run": "deno task --cwd ./documentation run",
    "documentation/watch": "deno task --cwd ./documentation watch",
    "documentation/stop": "deno task --cwd ./documentation stop",
    "documentation/bundle": "deno task --cwd ./documentation bundle",

    "vivalence/build": "docker build -f ./Dockerfile -t vivalence/viva:alpine .",
    "runtime/build": "docker build -f ./systems/runtime/Dockerfile -t vivalence/runtime:alpine .",
    "anima/stamp": "echo \"$(jj log --no-pager --ignore-working-copy --color=never -r @ --no-graph -T 'change_id.short(8)') $(jj log --no-pager --ignore-working-copy --color=never -r @ --no-graph -T 'commit_id.short(8)') $(git log -1 --format=%cI)\"",
    "anima/build": "docker build --build-arg VIVA_STAMP=\"$(deno task -q anima/stamp)\" -f ./systems/anima/Dockerfile -t vivalence/anima:alpine .",
    "documentation/build": "docker build -f ./documentation/Dockerfile -t vivalence/documentation:alpine .",
    "build": "DOCKER_BUILDKIT=1 deno task vivalence/build && deno task runtime/build && deno task anima/build && deno task documentation/build",

    "vivalence/tag": "docker tag vivalence/viva:alpine registry.vivalence.org/beef/viva/vivalence/viva:alpine",
    "runtime/tag": "docker tag vivalence/runtime:alpine registry.vivalence.org/beef/viva/vivalence/runtime:alpine",
    "anima/tag": "docker tag vivalence/anima:alpine registry.vivalence.org/beef/viva/vivalence/anima:alpine",
    "documentation/tag": "docker tag vivalence/documentation:alpine registry.vivalence.org/beef/viva/vivalence/documentation:alpine",
    "tag": "deno task vivalence/tag && deno task runtime/tag && deno task anima/tag && deno task documentation/tag",

    "vivalence/push": "docker push registry.vivalence.org/beef/viva/vivalence/viva:alpine",
    "runtime/push": "docker push registry.vivalence.org/beef/viva/vivalence/runtime:alpine",
    "anima/push": "docker push registry.vivalence.org/beef/viva/vivalence/anima:alpine",
    "documentation/push": "docker push registry.vivalence.org/beef/viva/vivalence/documentation:alpine",
    "push": "deno task vivalence/push && deno task runtime/push && deno task anima/push && deno task documentation/push",

    "publish": "deno task build && deno task tag && deno task push",
  },
  "allowScripts": {
    "allow": [],
    "deny": ["npm:argon2", "npm:esbuild", "npm:sqlite3", "npm:svelte-preprocess", "npm:fsevents"],
  },
}

