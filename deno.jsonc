{
  "workspace": [
    "./config",
    "./packages/clients/user",
    "./packages/daemon",
    "./packages/shared",
    "./packages/services"
  ],
  "importMap": "./import_map.json",
  "tasks": {
    "daemon:dev": "cd packages/daemon && deno task dev",
    "user:dev": "cd packages/clients/user && deno task dev",

    "prisma:schema:load": "deno run --allow-read --allow-write packages/database/prisma/schema.js",
    "prisma:schema:format": "prisma format --schema=packages/database/prisma/schema.prisma",
    "prisma:schema": "deno task prisma:schema:load && deno task prisma:schema:format",
    "prisma:migrate": "deno task prisma:schema && prisma migrate dev --schema=packages/database/prisma/schema.prisma",
    "prisma:generate": "deno task prisma:schema && prisma generate --schema=packages/database/prisma/schema.prisma"
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window", "dom"],
    "strict": true
  },
  "lint": {
    "files": {
      "include": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx"]
    },
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "files": {
      "include": ["**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx", "**/*.md"],
      "exclude": ["**/*.svelte", "**/*.viva"]
    },
    "options": {
      "useTabs": false,
      "singleQuote": false,
      "lineWidth": 100,
      "indentWidth": 2,
    }
  }
}
