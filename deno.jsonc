{
  "importMap": "./import_map.json",
  "workspace": [
    "./config",
    "./packages/shared",
    "./packages/schema",
    "./packages/registry",
    "./packages/interfaces",
    "./packages/clients/web",
    "./packages/clients/viva",
  ],
  "tasks": {
    "viva:dev": "VIVA_ROLE=sudo deno run --watch -A ./packages/viva/mod.js",
    "viva": "VIVA_ROLE=sudo deno run -A ./packages/viva/mod.js",
    "viva:install": "deno install --global -f -A -n viva ./packages/viva/cli.js",

    "daemon:dev": "VIVA_ROLE=daemon deno run -A --watch packages/daemon/mod.js",
    "clients:web:dev": "VIVA_ROLE=client deno run -A packages/clients/web/mod.js",

    "schema:compile": "VIVA_ROLE=sudo deno run -A packages/schema/compile.js",
    "schema:deploy": "deno task schema:compile && VIVA_ROLE=sudo deno run -A packages/schema/deploy.js",
  },
}
