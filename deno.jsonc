{
  "nodeModulesDir": "auto",
  "importMap": "./import_map.json",
  "exclude": ["./tilde/"],
  "workspace": [
    "./systems/daemon",
    "./systems/clients/html",
    "./systems/clients/shell",
    "./subsystems/surfaces/html",
    "./subsystems/surfaces/shell",
    "./subsystems/typology",
    "./subsystems/entities",
    "./subsystems/paladin",
    "./subsystems/tools",
    "./subsystems/drapes",
    "./subsystems/vector",
    "./subsystems/vip",
  ],
  "tasks": {
    "deno:install": "deno install --allow-scripts=npm:sqlite3,npm:svelte-preprocess",
    "viva:install": "deno install --global -f -A -n viva ./systems/clients/shell/entry.js $PWD",
    "install": "deno run deno:install && deno run viva:install && deno run html:install",
    "daemon:watch": "deno run --watch -A  ./systems/daemon/mod.ts",
    "daemon:start": "deno run  -A  ./systems/daemon/mod.ts",
    "html:install": "deno run viva system clients html install",
    "html:watch": "deno run viva system clients html start",
    "shell:run": "deno run -A ./systems/clients/shell/mod.js",
    "shell:watch": "deno run --watch -A ./systems/clients/shell/mod.js",
    "viva": "deno run -A ./systems/clients/shell/mod.js",
  },
}
