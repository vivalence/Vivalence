---
const { name } = Astro.props
const all = import.meta.glob("../../content/docs/**/*.snapshot.json", { eager: true })
const byName = Object.fromEntries(Object.entries(all).map(([path, module]) => [path.split("/").pop(), module]))
const data = byName[`${name}.snapshot.json`]?.default ?? { name, logs: [], error: null }
---
<div class="capture">
  <div class="capture-head"><span>{data.name}</span><span class="capture-channel">stdout</span></div>
  {data.logs.map((line) => <pre class="log-line">{line}</pre>)}
  {data.error && <pre class="log-line err">{data.error}</pre>}
</div>
