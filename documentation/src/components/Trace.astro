---
const { name } = Astro.props
const all = import.meta.glob("../../content/docs/**/*.snapshot.json", { eager: true })
const byName = Object.fromEntries(Object.entries(all).map(([path, module]) => [path.split("/").pop(), module]))
const data = byName[`${name}.snapshot.json`]?.default ?? { name, records: [] }
const records = data.records ?? []
let depth = 0
const rows = records.map((record) => {
  if (record.verb === "close") depth = Math.max(0, depth - 1)
  const row = { verb: record.verb, data: record.data, depth }
  if (record.verb === "open") depth += 1
  return row
})
---
<div class="trace">
  <div class="capture-head"><span>{data.name}</span><span class="capture-channel">span · {records.length} records</span></div>
  {rows.map((row) => (
    <div class="trace-row" style={`padding-left: ${0.9 + row.depth * 1.1}rem`}>
      <span class:list={["verb", row.verb]}>{row.verb}</span>
      {row.data && <code class="trace-data">{JSON.stringify(row.data)}</code>}
    </div>
  ))}
</div>
