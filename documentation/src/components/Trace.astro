---
import { capture, fold } from "../lib/trace.js"

const { name } = Astro.props
const data = capture(name) ?? { name, records: [] }
const records = data.records ?? []
const rows = fold(records)
---
<div class="panel">
  <div class="panel-head">
    <span class="pname">{data.name} — span</span>
    <span class="channel span"><span class="live"></span> span · {records.length} records</span>
  </div>
  <div class="body">
    {rows.map((row) => (
      <div class="trace-row" style={`padding-left: calc(0.9rem + ${row.depth * 1.6}ch)`}>
        <span class="depth">
          {Array.from({ length: row.depth }).map(() => <span class="guide"></span>)}
          <span class:list={["verb", row.verb]}>{row.verb}</span>
        </span>
        <span class="tbody">
          <span class="tname">{row.path}</span>
          {row.data && <span class="tdata"> {JSON.stringify(row.data)}</span>}
        </span>
        {row.duration && <span class="tms">{row.duration}</span>}
      </div>
    ))}
  </div>
</div>
