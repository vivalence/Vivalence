---
import { Code } from "astro:components"
const { name } = Astro.props
const sources = import.meta.glob("../../content/docs/**/*.example.js", { query: "?raw", import: "default", eager: true })
const byName = Object.fromEntries(Object.entries(sources).map(([path, code]) => [path.split("/").pop(), code]))
const code = (byName[`${name}.example.js`] ?? "").trim()
---
<Code code={code} lang="js" />
