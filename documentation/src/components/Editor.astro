---
const { code = "" } = Astro.props
---
<div class="panel editor" data-editor>
  <div class="panel-head">
    <span class="pname">playground</span>
    <span class="channel source">editor</span>
  </div>
  <textarea data-editor-source hidden set:text={code}></textarea>
  <div class="editor-bar">
    <span class="vim">VIM</span>
    <span>codemirror 6 · esc for normal mode</span>
    <span class="mode">— NORMAL —</span>
  </div>
</div>

<script>
  import { EditorView, basicSetup } from "codemirror"
  import { EditorState } from "@codemirror/state"
  import { javascript } from "@codemirror/lang-javascript"
  import { vim } from "@replit/codemirror-vim"

  const theme = EditorView.theme({
    "&": { backgroundColor: "var(--code-bg)", color: "var(--ink)", fontSize: "0.855rem" },
    ".cm-content": { fontFamily: "var(--mono)", padding: "0.6rem 0" },
    ".cm-gutters": { backgroundColor: "transparent", border: "none", color: "var(--faint)" },
    ".cm-activeLineGutter": { backgroundColor: "transparent" },
    ".cm-activeLine": { backgroundColor: "color-mix(in srgb, var(--accent) 7%, transparent)" },
    "&.cm-focused": { outline: "none" },
    ".cm-cursor": { borderLeftColor: "var(--accent)", borderLeftWidth: "2px" },
    ".cm-fat-cursor": { background: "color-mix(in srgb, var(--accent) 55%, transparent)", color: "inherit" },
  })

  for (const host of document.querySelectorAll("[data-editor]")) {
    const source = host.querySelector("[data-editor-source]")
    if (!source) continue
    const doc = source.value
    const bar = host.querySelector(".editor-bar")
    source.remove()
    const view = new EditorView({
      state: EditorState.create({ doc, extensions: [vim(), basicSetup, javascript(), theme] }),
    })
    host.insertBefore(view.dom, bar)
  }
</script>
