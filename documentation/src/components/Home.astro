---
import { getCollection } from "astro:content"

const { data } = Astro.props

const docs = await getCollection("docs")
const byJdex = Object.fromEntries(docs.map((entry) => [entry.data.jdex, entry]))
const linkTo = (jdex) => (byJdex[jdex] ? `/${byJdex[jdex].id}` : "/jdex")
---
<div class="home">
  <div class="hero">
    {data.eyebrow && <div class="eyebrow">{data.eyebrow}</div>}
    <h1>{data.headline}</h1>
    {data.sub && <p class="sub">{data.sub}</p>}
    {data.totems && (
      <div class="totems">
        {data.totems.map((totem) => (
          <span class="totem"><b>{totem.term}</b> {totem.rest}</span>
        ))}
      </div>
    )}
  </div>
  <div class="home-body">
    {data.pillars && (
      <div class="pillars">
        {data.pillars.map((pillar) => (
          <a class="pillar" href={linkTo(pillar.jdex)}>
            <span class="pk">{pillar.key}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.desc}</p>
          </a>
        ))}
      </div>
    )}
    <div class="home-cols">
      {data.start && (
        <div>
          <h4>{data.start.title}</h4>
          <div class="startlist">
            {(data.start.items ?? []).map((step) => (
              <a href={linkTo(step.jdex)}>
                <span class="sn">{step.jdex}</span>
                <span class="st">{step.title}</span>
                <span class="sd">{step.desc}</span>
              </a>
            ))}
          </div>
        </div>
      )}
      <div class="home-side">
        <slot name="live" />
      </div>
    </div>
    <section class="guide-wrap">
      <article class="guide" data-pagefind-body><slot name="guide" /></article>
    </section>
  </div>
</div>
