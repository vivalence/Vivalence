# Ignore version control directories
.git/
.svn/
.hg/

# Ignore build and log directories
build/
logs/
dist/

# Ignore temporary files and directories
*.tmp
*.temp
*.swp
*~

# Ignore IDE and editor directories
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Ignore node_modules directory if using Node.js
node_modules/

# Ignore Python bytecode and virtual environment
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
pip-log.txt

# Ignore other unnecessary files
.DS_Store
Thumbs.db
